<!-- 导航模块 key="clean"：对应 SystemCleanerPage.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.SystemCleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>

        <!-- 可清理项卡片行 -->
        <Style x:Key="CatRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶栏 -->
            <RowDefinition Height="*"/>
            <!-- 内容滚动区 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部操作 -->
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#E8F5E9" VerticalAlignment="Center">
                        <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="{loc:Loc 系统清理|System Cleaner}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc 扫描并清理 C 盘垃圾，安全释放磁盘空间|Scan and clean up C: drive junk; safely free disk space}" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnScan" Content="{loc:Loc 开始扫描|Start Scan}" Height="40" Width="124"
                        FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#27AE60"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                        Click="BtnScan_Click"/>
            </Grid>
        </Border>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 概览 + 磁盘空间 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtReclaimLabel" Text="{loc:Loc 可清理空间|Reclaimable Space}" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="TxtReclaim" Text="{loc:Loc 尚未扫描|Not Scanned}" FontSize="30" FontWeight="Bold" Foreground="#27AE60"/>
                            <TextBlock x:Name="TxtTemp" Text="{loc:Loc 点击下方「开始扫描」分析 C 盘垃圾|Click Start Scan below to analyze C drive junk}" FontSize="12" Foreground="#95A5A6" Margin="0,6,0,0"/>
                            <ProgressBar x:Name="ScanProgress" Height="6" Margin="0,12,0,0"
                                         Background="#E8EEF5" Foreground="#27AE60"
                                         BorderThickness="0" Value="0" Maximum="100" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 磁盘占用环形图 -->
                        <Grid Grid.Column="1" Width="96" Height="96" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Ellipse x:Name="RingTrack" Width="96" Height="96" Stroke="#E8EEF5" StrokeThickness="12"/>
                            <Ellipse x:Name="RingValue" Width="96" Height="96" StrokeThickness="12"
                                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                     StrokeDashArray="0 999">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" CenterX="48" CenterY="48"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RingPct" Text="—" FontSize="20" FontWeight="Bold"
                                           Foreground="#4A90D9" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 已用|Used}" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 磁盘使用条：环形 + 文字 + 图形结合（色块上直接显示已用 / 可用） -->
                <StackPanel Margin="0,18,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDiskTotal" Text="{loc:Loc 总容量：—|Total capacity: —}" FontSize="12" Foreground="#7F8C8D"/>
                        <TextBlock x:Name="TxtPctLabel" Grid.Column="1" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#4A90D9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border x:Name="BarTrack" Height="26" CornerRadius="13" Background="#E8EEF5">
                        <Grid x:Name="BarGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62*"/>
                                <ColumnDefinition Width="38*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BarUsed" Grid.Column="0" Background="#4A90D9" CornerRadius="13,0,0,13">
                                <TextBlock x:Name="TxtBarUsed" Text="" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BarFree" Grid.Column="1" Background="#E1E6EC" CornerRadius="0,13,13,0">
                                <TextBlock x:Name="TxtBarFree" Text="" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtUsedFree" Text="" FontSize="11.5" Foreground="#7F8C8D" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 可清理项 -->
                <TextBlock x:Name="TxtCatTitle" Text="{loc:Loc 可清理项（勾选后清理）|Cleanup items (check to clean)}" Style="{StaticResource SectionTitle}"/>
                <StackPanel x:Name="CategoryPanel"/>

                <!-- 大文件建议 -->
                <TextBlock x:Name="TxtBigTitle" Text="{loc:Loc 大文件建议（&gt;200MB，点击打开所在文件夹）|Large file suggestions (&gt;200MB, click to open containing folder)}" Style="{StaticResource SectionTitle}" Margin="4,18,0,12"/>
                <StackPanel x:Name="BigFilePanel"/>

                <!-- 磁盘空间可视化 Treemap（N2） -->
                <TextBlock x:Name="TxtTreemapTitle" Style="{StaticResource SectionTitle}" Margin="4,18,0,12"/>
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtDriveLabel" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="13" Foreground="#2C3E50"/>
                            <ComboBox x:Name="CmbDrives" Width="92" Height="34" VerticalAlignment="Center"
                                      SelectedIndex="0" Background="White" BorderBrush="#EDF0F3"
                                      SelectionChanged="CmbDrives_SelectionChanged"/>
                            <Button x:Name="BtnTreemapScan" Height="36" Width="120" Margin="12,0,0,0"
                                    FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="BtnTreemapScan_Click"/>
                            <Button x:Name="BtnTreemapBack" Height="36" Width="96" Margin="12,0,0,0"
                                    FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Visibility="Collapsed" Click="BtnTreemapBack_Click"/>
                        </StackPanel>
                        <ProgressBar x:Name="TreemapProgress" Height="6" Margin="0,0,0,10" Background="#E8EEF5"
                                     Foreground="#4A90D9" BorderThickness="0" Value="0" Maximum="100"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtTreemapInfo" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                        <Canvas x:Name="TreemapCanvas" Height="360" Background="#F7F9FB" ClipToBounds="True"
                                SizeChanged="TreemapCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- 安全设置：还原点（N7）+ 隐私痕迹（N13） -->
                <TextBlock x:Name="TxtSettingsTitle" Style="{StaticResource SectionTitle}" Margin="4,18,0,12"/>
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox x:Name="ChkRestorePoint" VerticalContentAlignment="Center" FontSize="13"
                                  Foreground="#2C3E50"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnRestorePoint" Height="36" Width="170"
                                    FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="BtnRestorePoint_Click"/>
                            <TextBlock x:Name="TxtRestoreResult" FontSize="12" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="#7F8C8D"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkPrivacy" VerticalContentAlignment="Center" FontSize="13"
                                  Foreground="#2C3E50" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="2" Height="64"
                BorderBrush="#EDF0F3" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TxtStatus" Text="{loc:Loc 点击「开始扫描」分析 C 盘垃圾文件|Click Start Scan to analyze C drive junk files}" FontSize="12"
                           Foreground="#7F8C8D" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button x:Name="BtnClean" Content="{loc:Loc 立即清理选中项|Clean Selected Items}" Height="38" Width="170" IsEnabled="False"
                        FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#4A90D9"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnClean_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
