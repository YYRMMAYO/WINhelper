                        <TextBlock x:Name="CatComm" Text="{loc:Loc 📞 通讯 / 会议|📞 Communication / Meeting}" Style="{StaticResource GroupHeader}"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource GlassCard}" Width="210" Height="116" CornerRadius="12" Margin="0,0,12,12">
                                <StackPanel VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="{loc:Loc 📹 腾讯会议|📹 Tencent Meeting}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Text="{loc:Loc 高清视频会议|HD video conferencing}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
