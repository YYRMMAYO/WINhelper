<!-- 导航模块 key="duplicate"：对应 DuplicateFilePage.xaml.cs（v5.3.0 新增）。
     查找并清理重复文件：按「文件名 + 大小」分组 → SHA-256 校验 → 删除前移入回收站（可恢复）。 -->
<UserControl x:Class="WINHELP.DuplicateFilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WINHELP"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="DupPageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DupPageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="DupSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource DupPageTitle}"
                   Text="{loc:Loc 重复文件查找|Duplicate Files}"/>
        <TextBlock Style="{StaticResource DupPageSub}"
                   Text="{loc:Loc 按文件名与大小分组，经 SHA-256 校验后找出真正的重复文件。删除操作一律移入回收站，可随时恢复。|Groups files by name &amp; size, then verifies with SHA-256. Deletions go to the Recycle Bin and are recoverable.}"/>

        <!-- 扫描设置卡 -->
        <Border Style="{StaticResource GlassCard}" Padding="20,18" Margin="0,0,0,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{loc:Loc 扫描目录|Scan folder}"
                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1" x:Name="TxtFolder" Height="36" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13"
                             Background="#F2F4F7" BorderThickness="1" BorderBrush="#E3E7EC"
                             CaretBrush="{DynamicResource AccentBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Text="{loc:Loc 选择要扫描的文件夹…|Choose a folder to scan…}"/>

                    <Button Grid.Column="2" x:Name="BtnPick" Height="36" Margin="10,0,0,0" Padding="16,0"
                            FontSize="13" Cursor="Hand" Content="{loc:Loc 选择…|Browse…}"
                            Click="BtnPick_Click"/>

                    <Button Grid.Column="3" x:Name="BtnScan" Height="36" Margin="10,0,0,0" Padding="20,0"
                            FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Content="{loc:Loc 开始扫描|Scan}" Click="BtnScan_Click"/>
                </Grid>

                <!-- 进度 -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <ProgressBar x:Name="ScanProgress" Height="6" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}" Background="#EDF0F4"/>
                    <TextBlock x:Name="TxtProgress" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 结果区 -->
        <Border Style="{StaticResource GlassCard}" Padding="20,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtResultTitle" Style="{StaticResource DupSectionTitle}"
                               Text="{loc:Loc 扫描结果|Results}"/>
                    <Button x:Name="BtnCleanAll" Grid.Column="2" Height="30" Padding="14,0" Margin="10,0,0,0"
                            FontSize="12" Cursor="Hand" IsEnabled="False"
                            Content="{loc:Loc 全部清理（每组保留 1 个）|Clean All (keep 1 per group)}"
                            Click="BtnCleanAll_Click"/>
                    <TextBlock x:Name="TxtSummary" Grid.Column="1" FontSize="12"
                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 空态提示 -->
                <TextBlock x:Name="TxtEmpty" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{loc:Loc 选择一个文件夹并点击「开始扫描」，将在此处显示重复文件分组。|Pick a folder and click Scan — duplicate groups will be listed here.}"/>

                <!-- 分组列表（代码构建） -->
                <StackPanel x:Name="GroupsPanel" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
