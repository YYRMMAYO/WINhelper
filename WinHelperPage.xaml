                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc '🛠️ WIN 助手|🛠️ WIN Helper'}" FontSize="20" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc '— 实用软件 · 官方直通车|— Useful Software · Official Portal'}" FontSize="13"
                               Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Name="BtnBack" Height="36" Width="110"
                        FontSize="13" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Content="{loc:Loc '← 返回首页|← Back to Home'}"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

