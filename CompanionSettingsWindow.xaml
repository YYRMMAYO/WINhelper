<!-- 独立窗体：小窗设置，由 CompanionWindow 启动。详见 MODULES.md -->
<Window x:Class="WINHELP.CompanionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WINHELP"
        Title="{loc:Loc 小窗设置|Mini Window Settings}" Height="460" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="Transparent" ShowInTaskbar="False">

    <Window.Resources>
        
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题 ===== -->
        <TextBlock Grid.Row="0" Text="{loc:Loc 🛠️ 小窗设置|🛠️ Mini Window Settings}" FontSize="16" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,14"/>

        <!-- ===== 用户自定义小窗图片 ===== -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc 自定义小窗图片|Custom Mini Window Image}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <TextBlock Text="{loc:Loc 选择一张本地图片显示在陪伴窗口的图形框中|Choose a local image to display in the companion window frame}" FontSize="11"
                           Foreground="#95A5A6" Margin="0,4,0,10" TextWrapping="Wrap"/>

                <!-- 图片预览 -->
                <Border Height="90" CornerRadius="8" Background="#F5F7FA" ClipToBounds="True" Margin="0,0,0,10">
                    <Grid>
                        <Image Name="ImgPreview" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Name="ImgPreviewTip" Text="{loc:Loc 暂未选择图片|No image selected}"
                                   FontSize="11" Foreground="#B0B8C0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Name="TxtImagePath" Text="{loc:Loc （未设置）|(Not set)}" FontSize="11"
                           Foreground="#7F8C8D" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Name="BtnPickImage" Height="32" Content="{loc:Loc 📁 选择图片|📁 Choose Image}"
                            Background="#4A90D9" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BtnPickImage_Click"/>
                    <Button Grid.Column="2" Name="BtnClearImage" Height="32" Width="80" Content="{loc:Loc 清除图片|Clear Image}"
                            Background="#ECF0F1" Foreground="#7F8C8D" BorderThickness="0"
                            Cursor="Hand" Click="BtnClearImage_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 北京时间链接 ===== -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="2" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="{loc:Loc 北京时间|Beijing Time}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#95A5A6" Margin="0,4,0,10"
                           Text="{loc:Loc 链接北京时间充当计时器，通过 http://time.syiban.com/ 同步标准北京时间|Use Beijing time as a timer, synced via http://time.syiban.com/}"/>

                <CheckBox Name="ChkSyncTime" Content="{loc:Loc 链接北京时间（在线同步）|Sync Beijing time (online)}"
                          FontSize="12" Foreground="#2C3E50" Cursor="Hand"
                          Click="Toggle_Changed" Margin="0,0,0,8"/>
                <CheckBox Name="ChkSeconds" Content="{loc:Loc 显示秒|Show Seconds}"
                          FontSize="12" Foreground="#2C3E50" Cursor="Hand"
                          Click="Toggle_Changed" Margin="0,0,0,8"/>
                <CheckBox Name="ChkOnTop" Content="{loc:Loc 小窗始终置顶|Always on Top}"
                          FontSize="12" Foreground="#2C3E50" Cursor="Hand"
                          Click="Toggle_Changed"/>
            </StackPanel>
        </Border>

        <!-- ===== 底部按钮 ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="BtnDone" Height="34" Width="100" Content="{loc:Loc 完成|Done}"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="BtnDone_Click"/>
        </StackPanel>
    </Grid>
</Window>
