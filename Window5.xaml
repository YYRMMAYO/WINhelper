<UserControl x:Class="WINHELP.Window5"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐞" FontSize="20" VerticalAlignment="Center" Margin="0,-2,10,0"/>
                    <TextBlock Text="BUG 反馈" FontSize="20" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <StackPanel Grid.Row="1">
                <!-- 说明卡片 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="24,22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="发现问题？告诉我们！" FontSize="18" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap"
                                   LineHeight="22">
                            感谢您使用 司南工具箱！如果您在使用过程中遇到任何问题、崩溃、
                            功能异常或有改进建议，欢迎通过下方腾讯文档表单提交反馈。
                            您的每一条反馈都将帮助我们持续改进软件体验。
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 反馈表单入口 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="24,22" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="📋" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="腾讯文档 · BUG 收集表单" FontSize="16" FontWeight="Bold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,0,0,18">
                            点击下方按钮即可打开在线反馈表单，填写问题描述和复现步骤后提交。
                        </TextBlock>

                        <!-- 反馈要点 -->
                        <Border Background="#F8F9FA" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="💡 反馈时建议包含以下信息：" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#2C3E50" Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" LineHeight="20">
                                    • 问题发生的具体操作步骤<LineBreak/>
                                    • 软件版本号（见首页底部或设置-关于）<LineBreak/>
                                    • 操作系统版本<LineBreak/>
                                    • 是否能稳定复现<LineBreak/>
                                    • 错误截图或错误提示文字
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Name="BtnOpenForm" Height="48" Width="280"
                                FontSize="15" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Content="📝 打开 BUG 反馈表单"
                                Click="Button_Click_OpenForm"/>
                    </StackPanel>
                </Border>

                <!-- 快速联系 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="24,22">
                    <StackPanel>
                        <TextBlock Text="📦 其他获取方式" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="GitHub Issues" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="在 GitHub 仓库提交 Issue 反馈问题" FontSize="12"
                                           Foreground="#95A5A6" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Name="BtnGitHub" Height="36" Width="100"
                                    FontSize="13" FontWeight="SemiBold"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Content="前往" Click="Button_Click_GitHub"/>
                        </Grid>
                    </StackPanel>
                </Border>
        </StackPanel>
    </Grid>
</UserControl>
