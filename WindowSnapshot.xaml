<UserControl x:Class="WINHELP.WindowSnapshot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Padding="20,16" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="#E8F0FE" VerticalAlignment="Center">
                    <TextBlock Text="📸" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Name="TxtTitle" Text="{loc:Loc 截图标注|Screenshot Annotation}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Name="TxtSub" Text="{loc:Loc 截图 + 箭头 / 文字 / 马赛克标注 + 取色|Screenshot + Arrow / Text / Mosaic Annotation + Color Picker}" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具栏（分组） -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="1" Padding="10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Name="TxtGrpShot" Style="{StaticResource GroupCaption}" Text="{loc:Loc 截图|Capture}"/>
                    <Button Name="BtnCaptureFull" Content="{loc:Loc 全屏截图|Full Screen Capture}" Width="92" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnCaptureFull_Click"/>
                    <Button Name="BtnCaptureAll" Content="{loc:Loc 全屏(多显示器)|Full Screen (Multi-monitor)}" Width="116" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnCaptureAll_Click"/>
                    <Button Name="BtnCaptureRegion" Content="{loc:Loc 区域截图|Region Capture}" Width="92" Height="34" Style="{StaticResource GlassToolbarButton}" Click="BtnCaptureRegion_Click"/>
                </StackPanel>
                <Separator Width="1" Margin="6,0,10,0" Background="#E0E0E0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Name="TxtGrpView" Style="{StaticResource GroupCaption}" Text="{loc:Loc 视图|View}"/>
                    <Button Name="BtnFit" Content="{loc:Loc 适应窗口|Fit to Window}" Width="84" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnFit_Click"/>
                    <Button Name="BtnActual" Content="{loc:Loc 实际大小|Actual Size}" Width="84" Height="34" Style="{StaticResource GlassToolbarButton}" Click="BtnActual_Click"/>
                </StackPanel>
                <Separator Width="1" Margin="6,0,10,0" Background="#E0E0E0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Name="TxtGrpAnno" Style="{StaticResource GroupCaption}" Text="{loc:Loc 标注|Annotate}"/>
                    <Button Name="BtnArrow" Content="{loc:Loc 箭头|Arrow}" Width="64" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnTool_Click"/>
                    <Button Name="BtnText" Content="{loc:Loc 文字|Text}" Width="64" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnTool_Click"/>
                    <Button Name="BtnMosaic" Content="{loc:Loc 马赛克|Mosaic}" Width="72" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnTool_Click"/>
                    <Button Name="BtnPicker" Content="{loc:Loc 取色器|Color Picker}" Width="72" Height="34" Style="{StaticResource GlassToolbarButton}" Click="BtnTool_Click"/>
                </StackPanel>
                <Separator Width="1" Margin="6,0,10,0" Background="#E0E0E0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="TxtGrpAct" Style="{StaticResource GroupCaption}" Text="{loc:Loc 操作|Actions}"/>
                    <Button Name="BtnClearAnno" Content="{loc:Loc 清除标注|Clear Annotation}" Width="84" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnClearAnno_Click"/>
                    <Button Name="BtnClearImg" Content="{loc:Loc 清除截图|Clear Screenshot}" Width="84" Height="34" Style="{StaticResource GlassToolbarButton}" Margin="0,0,6,0" Click="BtnClearImg_Click"/>
                    <Button Name="BtnSave" Content="{loc:Loc 保存|Save}" Width="84" Height="34" Style="{StaticResource GlassToolbarButton}" Click="BtnSave_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 工具选项（按当前工具动态显示） -->
        <Border Name="ToolOptions" Grid.Row="2" Style="{StaticResource GlassCard}" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Name="ToolOptionsPanel" VerticalAlignment="Center"/>
        </Border>

        <!-- 图片区 -->
        <Border Name="ImageAreaBorder" Grid.Row="3" Style="{StaticResource GlassCard}" Padding="8" Margin="0,0,0,10"
                SizeChanged="ImageAreaBorder_SizeChanged">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid Name="CanvasHost">
                    <Image Name="ImgCapture" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Canvas Name="AnnotationCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseDown" MouseLeftButtonUp="Canvas_MouseUp" MouseMove="Canvas_MouseMove"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="TxtStatus" Text="{loc:Loc 尚未截图|No screenshot taken}" FontSize="12.5" Foreground="#7F8C8D" VerticalAlignment="Center"/>
            <TextBlock Name="TxtCursor" Grid.Column="1" Text="" FontSize="11.5" Foreground="#95A5A6" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
            <TextBlock Name="TxtImgInfo" Grid.Column="2" Text="" FontSize="11.5" Foreground="#95A5A6" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
            <Border Name="ColorSwatch" Grid.Column="3" Width="64" Height="26" CornerRadius="6" Background="#DDDDDD" BorderBrush="#BBBBBB" BorderThickness="1" Margin="12,0,0,0" Visibility="Collapsed">
                <TextBlock Name="TxtColor" Text="" FontSize="11" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
