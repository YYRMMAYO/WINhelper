<UserControl x:Class="WINHELP.Window6"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        

        <!-- 系统工具按钮样式 -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A90D9"/>
            <Setter Property="Background" Value="#EBF3FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E8FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 技巧卡片标题样式 -->
        <Style x:Key="TipTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TipBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💻" FontSize="20" VerticalAlignment="Center" Margin="0,-2,10,0"/>
                    <TextBlock Text="电脑帮助" FontSize="20" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text="— Windows 实用指南" FontSize="13"
                               Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <StackPanel Grid.Row="1">
                <!-- 系统信息 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🖥️ 系统信息" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="操作系统" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtOS" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="系统位数" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtArch" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET 版本" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDotNet" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="机器名称" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtMachine" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统工具快捷入口 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚙️ 系统工具 · 一键打开" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ToolButton}" Content="📁 控制面板" Click="Btn_ControlPanel"/>
                            <Button Style="{StaticResource ToolButton}" Content="📊 任务管理器" Click="Btn_TaskMgr"/>
                            <Button Style="{StaticResource ToolButton}" Content="🧹 磁盘清理" Click="Btn_DiskCleanup"/>
                            <Button Style="{StaticResource ToolButton}" Content="💾 磁盘管理" Click="Btn_DiskMgmt"/>
                            <Button Style="{StaticResource ToolButton}" Content="🔧 设备管理器" Click="Btn_DevMgr"/>
                            <Button Style="{StaticResource ToolButton}" Content="🌐 网络连接" Click="Btn_Network"/>
                            <Button Style="{StaticResource ToolButton}" Content="📋 剪贴板历史" Click="Btn_Clipboard"/>
                            <Button Style="{StaticResource ToolButton}" Content="🔋 电源选项" Click="Btn_Power"/>
                            <Button Style="{StaticResource ToolButton}" Content="🖱️ 鼠标属性" Click="Btn_Mouse"/>
                            <Button Style="{StaticResource ToolButton}" Content="🎨 显示设置" Click="Btn_Display"/>
                            <Button Style="{StaticResource ToolButton}" Content="🔊 声音设置" Click="Btn_Sound"/>
                            <Button Style="{StaticResource ToolButton}" Content="🕒 日期时间" Click="Btn_DateTime"/>
                            <Button Style="{StaticResource ToolButton}" Content="🔤 输入法" Click="Btn_Input"/>
                            <Button Style="{StaticResource ToolButton}" Content="📦 程序和功能" Click="Btn_Programs"/>
                            <Button Style="{StaticResource ToolButton}" Content="🔒 Windows 安全" Click="Btn_Security"/>
                            <Button Style="{StaticResource ToolButton}" Content="🚀 系统信息" Click="Btn_SysInfo"/>
                            <Button Style="{StaticResource ToolButton}" Content="⌨️ 屏幕键盘" Click="Btn_OSK"/>
                            <Button Style="{StaticResource ToolButton}" Content="🔍 放大镜" Click="Btn_Magnifier"/>
                            <Button Style="{StaticResource ToolButton}" Content="📸 截图工具" Click="Btn_Snipping"/>
                            <Button Style="{StaticResource ToolButton}" Content="📧 邮件" Click="Btn_Mail"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 常用快捷键 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⌨️ 常用快捷键速查" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>

                        <WrapPanel>
                            <!-- 快捷键卡片 -->
                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="窗口管理"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+D 显示桌面<LineBreak/>
                                        Win+Tab 任务视图<LineBreak/>
                                        Alt+Tab 切换窗口<LineBreak/>
                                        Win+↑/↓ 最大化/最小化
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="文件操作"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+E 打开资源管理器<LineBreak/>
                                        Ctrl+C/V 复制/粘贴<LineBreak/>
                                        Ctrl+Z 撤销<LineBreak/>
                                        Ctrl+Shift+Esc 任务管理器
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="截图与录屏"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+Shift+S 区域截图<LineBreak/>
                                        PrtSc 全屏截图<LineBreak/>
                                        Win+G 游戏录制栏<LineBreak/>
                                        Win+Alt+R 开始/停止录制
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="搜索与运行"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win 搜索/开始菜单<LineBreak/>
                                        Win+R 运行对话框<LineBreak/>
                                        Win+S 搜索<LineBreak/>
                                        Win+I 设置
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="虚拟桌面"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+Ctrl+D 新建桌面<LineBreak/>
                                        Win+Ctrl+←/→ 切换桌面<LineBreak/>
                                        Win+Ctrl+F4 关闭桌面
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="其他实用"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+V 剪贴板历史<LineBreak/>
                                        Win+; 表情符号面板<LineBreak/>
                                        Win+L 锁屏<LineBreak/>
                                        Ctrl+Shift+N 新建文件夹
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 实用技巧 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="💡 电脑实用技巧" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="1. 加速开机启动"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    打开任务管理器（Ctrl+Shift+Esc），切换到「启动」选项卡，
                                    禁用不需要开机自启的程序，可显著加快开机速度。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="2. 释放磁盘空间"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    定期使用「磁盘清理」工具清除临时文件和系统缓存。
                                    也可在设置 → 系统 → 存储中开启「存储感知」自动清理。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="3. 查看硬件信息"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    按 Win+R 输入 msinfo32 可打开系统信息窗口，
                                    查看处理器、内存、主板等详细硬件信息。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="4. 网络问题排查"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    网络不通时，按 Win+R 输入 cmd，再输入 ping www.baidu.com
                                    测试连通性。也可尝试 ipconfig /flushdns 刷新 DNS 缓存。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="5. 安全模式启动"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    按住 Shift 点击重启，或设置 → 恢复 → 高级启动，
                                    可进入安全模式排查驱动或软件冲突问题。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
        </StackPanel>
    </Grid>
</UserControl>
