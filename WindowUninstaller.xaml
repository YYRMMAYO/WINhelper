<UserControl x:Class="WINHELP.WindowUninstaller"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <Style x:Key="ProgRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ResRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Padding="20,16" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="#EAF0FB" VerticalAlignment="Center">
                    <TextBlock Text="🧩" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Name="TxtTitle" Text="卸载残留" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Name="TxtSub" Text="管理已安装程序，清理卸载后的残留文件" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="BtnScan" Grid.Column="0" Content="扫描已安装程序" Height="38"
                    Style="{StaticResource GlassToolbarButton}" HorizontalAlignment="Stretch" Click="BtnScan_Click"/>
            <Button Name="BtnUninstall" Grid.Column="1" Content="卸载" Width="100" Height="38" Margin="10,0,0,0"
                    Style="{StaticResource GlassToolbarButton}" Background="#E67E22" IsEnabled="False" Click="BtnUninstall_Click"/>
        </Grid>

        <!-- 程序列表 -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="8" Margin="0,0,0,12">
            <ListBox Name="ListPrograms" Background="Transparent" BorderThickness="0"
                     SelectionChanged="ListPrograms_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProgRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#2C3E50" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                           Foreground="#7F8C8D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 残留工具栏 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="TxtResidueTitle" Text="残留文件" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button Name="BtnScanResidue" Grid.Column="1" Content="扫描残留" Width="100" Height="34"
                    Style="{StaticResource GlassToolbarButton}" Background="#5B8DEF" IsEnabled="False" Margin="0,0,10,0" Click="BtnScanResidue_Click"/>
            <Button Name="BtnDeleteResidue" Grid.Column="2" Content="删除选中" Width="100" Height="34"
                    Style="{StaticResource GlassToolbarButton}" Background="#E74C3C" IsEnabled="False" Click="BtnDeleteResidue_Click"/>
        </Grid>

        <!-- 残留列表 -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="8" Margin="0,8,0,12">
            <ListBox Name="ListResidue" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ResRow}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="#2C3E50"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 状态 -->
        <TextBlock Name="TxtStatus" Grid.Row="5" Text="点击「扫描已安装程序」开始" FontSize="12.5" Foreground="#7F8C8D"/>
    </Grid>
</UserControl>
