<!-- 导航模块 key="home"：对应 HomePage.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WINHELP"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 次级卡片：常规大小 -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Width" Value="222"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="local:ClickAnim.IsEnabled" Value="True"/>
            <Setter Property="local:ClickAnim.HoverScale" Value="1.03"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="1" Direction="270" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主级卡片：更大、带强调色图标底，体现主次层级 -->
        <Style x:Key="HomeCardPrimary" TargetType="Border" BasedOn="{StaticResource HomeCard}">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="142"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- 一键优化卡片：与普通主级卡片同尺寸，强调色底 + 白字（不再独占整行，降低占比） -->
        <Style x:Key="HomeCardOptimize" TargetType="Border">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="142"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="local:ClickAnim.IsEnabled" Value="True"/>
            <Setter Property="local:ClickAnim.HoverScale" Value="1.03"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#2E86C1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标底（主级卡片用，强调色淡底） -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#1A4A90D9"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- 分组标题样式 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
            <Setter Property="Margin" Value="4,4,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel>
            <!-- ===== 系统工具分组 ===== -->
            <TextBlock x:Name="SecSystem" Text="系统工具" Style="{StaticResource SectionHeader}"/>
            <WrapPanel x:Name="CardsWrapSystem" Orientation="Horizontal">

                <!-- 一键优化：与普通卡片同尺寸，不再独占整行（需求 #4）。
                     其余系统工具卡片由 HomePage.xaml.cs 依据 ModuleRegistry 动态生成。 -->
                <Border Style="{StaticResource HomeCardOptimize}" Name="CardOptimize" Tag="optimize" MouseLeftButtonDown="Card_Click">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="4,0,86,0">
                            <TextBlock Text="一键优化" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="清理临时文件 · 释放空间" FontSize="12.5" Foreground="#E8F1FB" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="点此立即优化" FontSize="11.5" Foreground="#CFE3F7" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="64" Height="64" CornerRadius="18" Background="#26FFFFFF"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </WrapPanel>

            <!-- ===== 效率工具分组（卡片由 ModuleRegistry 动态生成） ===== -->
            <TextBlock x:Name="SecTools" Text="效率工具" Style="{StaticResource SectionHeader}" Margin="4,18,0,10"/>
            <WrapPanel x:Name="CardsWrapTools" Orientation="Horizontal"/>

            <!-- ===== 助手与信息分组（卡片由 ModuleRegistry 动态生成） ===== -->
            <TextBlock x:Name="SecAssist" Text="助手与信息" Style="{StaticResource SectionHeader}" Margin="4,18,0,10"/>
            <WrapPanel x:Name="CardsWrapAssist" Orientation="Horizontal"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
