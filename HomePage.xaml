<!-- 导航模块 key="home"：对应 HomePage.xaml.cs，由 MainWindow 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WINHELP"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 功能卡片（v5.6.0：圆角更大、悬浮感更强，图标徽标更醒目） -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="132"/>
            <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
            <Setter Property="BorderBrush" Value="#E6E9EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="local:ClickAnim.IsEnabled" Value="True"/>
            <Setter Property="local:ClickAnim.HoverScale" Value="1.02"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首字徽标底盘（强调色淡底圆角块） -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource GlassNavActiveBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
            <Setter Property="Margin" Value="2,6,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
        <StackPanel>

            <!-- ===== 欢迎条（v5.6.0：主题色渐变横幅，问候 + 日期 + 统计 + 一键优化 + 求助家人） ===== -->
            <Border CornerRadius="16" Margin="0,0,0,22" Padding="26,22"
                    Panel.ZIndex="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource DarkerColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 日期块 -->
                    <Border Grid.Column="0" Width="58" Height="58" CornerRadius="14"
                            Background="#33FFFFFF" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtHeroDay" Text="--" FontSize="21" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeroMonth" Text="--" FontSize="11"
                                       Foreground="#E8FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 问候 + 统计 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,14,0">
                        <TextBlock x:Name="TxtHeroGreeting" FontSize="18" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="TxtHeroExtra" FontSize="12.5" Foreground="#E8FFFFFF"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 一键优化 -->
                        <Button x:Name="BtnWelcomeOptimize" Height="38" Padding="20,0"
                                FontSize="13" FontWeight="SemiBold" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Content="{loc:Loc 一键优化|One-Click Optimize}"
                                Click="BtnWelcomeOptimize_Click"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 系统工具分组 ===== -->
            <TextBlock x:Name="SecSystem" Style="{StaticResource SectionHeader}"/>
            <WrapPanel x:Name="CardsWrapSystem" Orientation="Horizontal"/>

            <!-- ===== 效率工具分组 ===== -->
            <TextBlock x:Name="SecTools" Style="{StaticResource SectionHeader}" Margin="2,20,0,12"/>
            <WrapPanel x:Name="CardsWrapTools" Orientation="Horizontal"/>

            <!-- ===== 助手与信息分组 ===== -->
            <TextBlock x:Name="SecAssist" Style="{StaticResource SectionHeader}" Margin="2,20,0,12"/>
            <WrapPanel x:Name="CardsWrapAssist" Orientation="Horizontal"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
