<UserControl x:Class="WINHELP.CompanionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 状态行通用样式 -->
        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏标题 -->
        <Grid Grid.Row="0" Margin="6,0,6,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Background="#FFF6E0"
                        VerticalAlignment="Center">
                    <TextBlock Text="💛" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="陪伴运行" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="以悬浮小窗常驻桌面，隐藏主界面，专注重心"
                               FontSize="12" Foreground="#95A5A6" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- 状态徽章：未开启 / 已开启 -->
            <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="14" Padding="14,6"
                    Background="#F0F2F5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusBadgeDot" Width="8" Height="8" Fill="#BDC3C7"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBadgeText" Text="未开启"
                               FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主内容：左大状态卡 + 右侧说明卡 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：主操作卡（带渐变背景的"大心脏"） -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" CornerRadius="16"
                    Padding="32,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 装饰光晕：根据状态变色（绿/灰） -->
                    <Border Grid.Row="0" HorizontalAlignment="Left"
                            Width="80" Height="80" CornerRadius="40" Margin="0,0,0,18">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop x:Name="HaloStop1" Color="#2227AE60" Offset="0"/>
                                <GradientStop x:Name="HaloStop2" Color="#0027AE60" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="HaloEmoji" Text="💛" FontSize="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="TxtBigStatus" Text="陪伴未运行"
                                   FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtBigDesc" Text="开启后程序会缩小成悬浮小窗，专注陪你工作。"
                                   FontSize="13" Foreground="#7F8C8D" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>

                    <!-- 状态信息表格 -->
                    <Grid Grid.Row="2" Margin="0,28,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource InfoLabel}" Text="当前模式"/>
                            <TextBlock Grid.Column="1" x:Name="TxtMode" Style="{StaticResource InfoValue}" Text="标准模式"/>
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="#EDF0F4" Margin="0,0,0,12"/>

                        <Grid Grid.Row="2" Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource InfoLabel}" Text="全局热键"/>
                            <TextBlock Grid.Column="1" x:Name="TxtHotkey" Style="{StaticResource InfoValue}"
                                       Text="Ctrl+Alt+C"/>
                            <Button Grid.Column="2" x:Name="BtnRebind" Content="重新设置" Height="28"
                                    Padding="12,0" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="BtnRebind_Click"/>
                        </Grid>

                        <!-- 录制热键提示面板（点击"重新设置"后出现） -->
                        <Border Grid.Row="3" x:Name="CapturePanel" Visibility="Collapsed" CornerRadius="10"
                                Background="#FFF6E0" BorderBrush="#FFD699" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCaptureHint"
                                               Text="请按下新的热键组合（需含 Ctrl / Alt / Shift 之一）…"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#8A6D3B"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtCaptureSub" Text="按下后自动生效并保存"
                                               FontSize="11" Foreground="#B08D57" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnCancelCapture" Content="取消"
                                        Height="28" Width="64" Margin="10,0,0,0" FontSize="12"
                                        Background="#ECF0F1" Foreground="#7F8C8D" BorderThickness="0"
                                        Cursor="Hand" Click="BtnCancelCapture_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Height="1" Background="#EDF0F4" Margin="0,0,0,12"/>
                    </Grid>

                    <!-- 主按钮 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="BtnToggle" Height="44" Width="180"
                                FontSize="14" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Content="开启陪伴运行"
                                Click="BtnToggle_Click"/>
                        <TextBlock x:Name="TxtHint" FontSize="11" Foreground="#BDC3C7"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   Text="按 F11 或全局热键也能切换"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：使用说明卡 -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" CornerRadius="16"
                    Padding="24,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="使用说明" FontSize="15" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <Border Background="#F2F3F5" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⌨️" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="快捷切换" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#2C3E50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#7F8C8D" LineHeight="20" TextWrapping="Wrap"
                                           Text="· F11 在主窗口内一键切换。&#xa;· 全局热键可在任意界面唤起陪伴小窗。"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2F3F5" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🪟" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="小窗模式" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#2C3E50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#7F8C8D" LineHeight="20" TextWrapping="Wrap"
                                           Text="· 开启后主窗口自动隐藏。&#xa;· 桌面仅保留小窗，可拖动调整位置。&#xa;· 双击系统托盘图标可恢复主窗口。"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2F3F5" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🔚" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="退出陪伴" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#2C3E50" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#7F8C8D" LineHeight="20" TextWrapping="Wrap"
                                           Text="· 在本页面点击「关闭陪伴运行」。&#xa;· 或再次按 F11 / 全局热键。&#xa;· 右键系统托盘图标也有快捷菜单。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 底部彩蛋小贴士 -->
                    <Border Grid.Row="2" VerticalAlignment="Bottom" Background="#FFFBEC"
                            BorderBrush="#FFE9A8" BorderThickness="1" CornerRadius="10"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="#8A6D3B" VerticalAlignment="Center"
                                       TextWrapping="Wrap" LineHeight="18"
                                       Text="陪伴运行适合：写作、阅读、追剧、专注工作等场景。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
