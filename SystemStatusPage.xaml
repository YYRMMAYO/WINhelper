<UserControl x:Class="WINHELP.SystemStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 分组小标题 -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="Margin" Value="2,14,0,8"/>
            <Setter Property="TextDecorations" Value="None"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 健康度 + 设备信息 -->
            <RowDefinition Height="*"/>
            <!-- 检测项目 -->
            <RowDefinition Height="Auto"/>
            <!-- 优化建议 -->
            <RowDefinition Height="Auto"/>
            <!-- 进程榜 -->
            <RowDefinition Height="Auto"/>
            <!-- 温度 + 智能诊断 -->
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="{loc:Loc 设备检测与优化|Device Detection &amp; Optimization}" FontSize="20" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc — 设备信息 · 完整性诊断 · 优化建议|— Device Info · Integrity Diagnosis · Optimization Suggestions}" FontSize="13"
                               Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 健康度仪表 + 设备信息 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 健康度圆环 -->
            <Border Style="{StaticResource GlassCard}" Grid.Column="0" CornerRadius="14" Padding="18" Margin="0,0,16,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc 系统健康度|System Health}" FontSize="13" Foreground="#7F8C8D"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Width="150" Height="150" Stroke="#E8EEF5" StrokeThickness="14"/>
                        <Ellipse x:Name="GaugeArc" Width="150" Height="150" Stroke="#27AE60" StrokeThickness="14"
                                 StrokeDashArray="0 999" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtScore" Text="—" FontSize="38" FontWeight="Bold"
                                       Foreground="#27AE60" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtGrade" Text="{loc:Loc 未检测|Not Detected}" FontSize="13" Foreground="#7F8C8D"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="BtnStart" Content="{loc:Loc ▶ 开始检测|▶ Start Detection}" Height="40" Width="150" Margin="0,16,0,0"
                            FontSize="14" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="Button_Click_Start"/>
                </StackPanel>
            </Border>

            <!-- 设备信息（分组：处理器 / 显卡 / 内存 / 主板 / 系统 / 存储） -->
            <Border Style="{StaticResource GlassCard}" Grid.Column="1" CornerRadius="14" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHwTitle" Text="{loc:Loc 设备信息|Device Info}" FontSize="15" FontWeight="Bold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHwStatus" FontSize="11" Foreground="#95A5A6"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Button Name="BtnRefreshHw" Height="32" Width="92"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Content="{loc:Loc ↻ 刷新|↻ Refresh}" HorizontalAlignment="Right"
                                Click="Button_RefreshHw_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HardwareList"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 检测项目（分组：系统完整性 / 网络与更新 / 运行与硬件） -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="2" CornerRadius="14" Padding="20,18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCheckTitle" Text="{loc:Loc 检测项目|Check Items}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtSummary" FontSize="12" Foreground="#95A5A6"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CheckList"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 优化建议（基于检测结果生成，可一键跳转对应模块） -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="3" CornerRadius="14" Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtOptTitle" Text="{loc:Loc 优化建议|Optimization Tips}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="TxtOptStatus" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="OptPanel" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- 进程榜 / 一键结束卡顿进程 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="4" CornerRadius="14" Padding="20,18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProcTitle" Text="{loc:Loc 进程榜|Process Ranking}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtProcStatus" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="BtnKillProc" Height="34" MinWidth="124" FontSize="12" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                Content="{loc:Loc ⛔ 结束选中进程|⛔ End Selected Process}" Click="BtnKillProc_Click"/>
                        <Button Name="BtnProcRefresh" Height="34" MinWidth="92" FontSize="12" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Content="{loc:Loc ↻ 刷新|↻ Refresh}"
                                Click="BtnProcRefresh_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc 名称|Name}" FontSize="11" FontWeight="Bold" Foreground="#95A5A6"/>
                    <TextBlock Grid.Column="1" Text="{loc:Loc 内存|Memory}" FontSize="11" FontWeight="Bold" Foreground="#95A5A6" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="CPU" FontSize="11" FontWeight="Bold" Foreground="#95A5A6" HorizontalAlignment="Right"/>
                </Grid>

                <ListBox Name="ProcList" Grid.Row="2" MaxHeight="300" BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,6"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EDF1F5"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#2C3E50" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="12" Foreground="#5D6D7E"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12" Foreground="#5D6D7E"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 温度/传感器 + 智能诊断 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 温度 -->
            <Border Style="{StaticResource GlassCard}" Grid.Column="0" CornerRadius="14" Padding="20,18" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtTempTitle" Text="{loc:Loc 🌡 温度 / 传感器|🌡 Temperature / Sensors}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <Button Name="BtnTempRefresh" Height="32" Width="92" FontSize="12" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                                Content="↻ 刷新" Click="BtnTempRefresh_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                        <TextBlock Text="CPU" FontSize="13" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtTemp" Text="—" FontSize="28" FontWeight="Bold" Foreground="#4A90D9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTempHint" Grid.Row="2" Text="{loc:Loc 通过 WMI 读取，部分设备不支持|Read via WMI; some devices unsupported}" FontSize="11" Foreground="#95A5A6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- 智能诊断 -->
            <Border Style="{StaticResource GlassCard}" Grid.Column="1" CornerRadius="14" Padding="20,18" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtDiagTitle" Text="{loc:Loc 🤖 智能诊断|🤖 Smart Diagnosis}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <Button Name="BtnDiag" Height="34" MinWidth="100" FontSize="12" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                                Content="{loc:Loc ▶ 开始诊断|▶ Start Diagnosis}" Click="BtnDiag_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DiagPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
