<!-- 导航模块 key="notes"：对应 NotesPage.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="NoteItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 输入区 -->
            <RowDefinition Height="*"/>
            <!-- 便签列表 -->
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Style="{DynamicResource GlassCard}" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="#FFF9E6" VerticalAlignment="Center">
                    <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TxtTitle" Text="{loc:Loc 桌面便签|Desktop Sticky Notes}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc 快速记录，自动保存到桌面|Quick notes, auto-saved to desktop}" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 输入区 -->
        <Border Grid.Row="1" Style="{DynamicResource GlassCard}" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBox x:Name="TxtNoteInput" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="#2C3E50"
                             BorderBrush="#E0E4E8" BorderThickness="1" Padding="10,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="ChkAlsoDesktop" Content="{loc:Loc 同时保存到桌面文件|Also save to desktop file}" IsChecked="True"
                                  Foreground="#5D6D7E" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0" Orientation="Horizontal">
                    <Button x:Name="BtnAddNote" Content="{loc:Loc 📝 添加便签|📝 Add Note}" Height="36" Width="100"
                            FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#4A90D9"
                            BorderThickness="0" Cursor="Hand" Click="BtnAddNote_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 便签列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Loc 📋 已保存的便签|📋 Saved Notes}" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TxtNoteCount" FontSize="12" Foreground="#95A5A6" Margin="4,0,0,10"/>
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource GlassCard}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                                    BorderBrush="#EDF0F3" BorderThickness="1" Background="White"
                                    MouseRightButtonDown="NoteItem_RightClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#2C3E50"
                                                   TextWrapping="Wrap" LineHeight="18"/>
                                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#95A5A6"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <Button Content="📂" FontSize="14" ToolTip="{loc:Loc 在资源管理器中打开|Open in File Explorer}" Width="30" Height="26"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Click="BtnOpenNote_Click" Tag="{Binding FilePath}"/>
                                        <Button Content="🗑️" FontSize="14" ToolTip="{loc:Loc 删除此条便签|Delete this note}" Width="30" Height="26"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Click="BtnDeleteNote_Click" Tag="{Binding FilePath}"
                                                Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TxtEmptyHint"
                           Text="{loc:Loc 还没有便签，在上方输入框写点什么吧～|No notes yet — type something above to get started.}"
                           FontSize="13" Foreground="#95A5A6" Margin="8,18,8,0" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
