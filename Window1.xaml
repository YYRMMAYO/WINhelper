<UserControl x:Class="WINHELP.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="Transparent">

    <UserControl.Resources>
        

        <!-- 网站按钮样式 — 主题色由代码动态设置 -->
        <Style x:Key="SiteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#E8ECF0" BorderThickness="1">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Text="→" FontSize="14" Foreground="#BDC3C7"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF3FC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D6E8FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分类标题样式 -->
        <Style x:Key="CategoryHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock x:Name="TxtTitle" Text="🌐 网站检索助手" FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button Name="BtnBack" Height="38" Width="110"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        Content="← 返回首页" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：常用网站（可滚动） -->
            <Border Style="{StaticResource GlassCard}" Grid.Column="0" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtCommonSites" Text="📌 常用网站" FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,4"/>

                        <TextBlock x:Name="CatVideo" Text="🎬 影音娱乐" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="优酷视频"
                                Click="Button_Click_6" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="爱奇艺"
                                Click="Button_Click_7" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="腾讯视频"
                                Click="Button_Click_8" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="Steam 商店"
                                Click="Button_Click_3" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="芒果TV"
                                Click="Button_Click_30" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="喜马拉雅"
                                Click="Button_Click_31" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CatSearch" Text="🔍 搜索引擎" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="百度搜索"
                                Click="Button_Click_10" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="Google 搜索"
                                Click="Button_Click_11" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="必应搜索"
                                Click="Button_Click_12" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CatSocial" Text="💬 社交社区" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="微博"
                                Click="Button_Click_13" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="知乎"
                                Click="Button_Click_14" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="小红书"
                                Click="Button_Click_15" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="豆瓣"
                                Click="Button_Click_16" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="百度贴吧"
                                Click="Button_Click_41" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CatShop" Text="🛒 购物电商" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="淘宝"
                                Click="Button_Click_17" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="京东"
                                Click="Button_Click_18" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="拼多多"
                                Click="Button_Click_19" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="唯品会"
                                Click="Button_Click_32" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="苏宁易购"
                                Click="Button_Click_33" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CatMusic" Text="🎵 音乐" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="网易云音乐"
                                Click="Button_Click_20" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="QQ音乐"
                                Click="Button_Click_21" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="酷狗音乐"
                                Click="Button_Click_34" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="咪咕音乐"
                                Click="Button_Click_35" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CatTool" Text="🔧 实用工具" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="Google 翻译"
                                Click="Button_Click_22" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="DeepL 翻译"
                                Click="Button_Click_23" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="百度网盘"
                                Click="Button_Click_24" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="阿里云盘"
                                Click="Button_Click_25" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="微信"
                                Click="Button_Click_36" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="微信输入法"
                                Click="BtnWeixinInput_Click" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="钉钉"
                                Click="Button_Click_37" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="腾讯文档"
                                Click="Button_Click_38" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CatNews" Text="📰 资讯学习" Style="{StaticResource CategoryHeader}"/>
                        <Button Style="{StaticResource SiteButton}" Content="GitHub"
                                Click="Button_Click_2" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="36氪"
                                Click="Button_Click_26" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="少数派"
                                Click="Button_Click_27" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="IT之家"
                                Click="Button_Click_28" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="维基百科 Wikipedia"
                                Click="Button_Click_29" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="中国大学MOOC"
                                Click="Button_Click_39" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SiteButton}" Content="果壳网"
                                Click="Button_Click_40" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧面板 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="TxtSteamTitle" Text="⚡ Steam++ 加速器" FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtSteamDesc" Text="进入 Steam 和 GitHub 前，建议先使用此加速器进行网页加速。"
                                   FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <Button Name="BtnSteamPP" Height="38" Width="220"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Content="打开加速器官网"
                                Click="Button_Click_1"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtUpdateTitle" Text="📦 软件更新" FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSoftwareVersion" FontSize="13"
                                   Foreground="#7F8C8D" Margin="0,0,0,8"
                                   ><Run Text="软件版本 V4.2.0"/></TextBlock>
                        <Button Name="BtnUpdate" Height="38" Width="220"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Content="获取更新"
                                Click="Button_Click_5"/>
                        <TextBlock x:Name="TxtPwd" Text="密码：YYRMM" FontSize="12"
                                   Foreground="#BDC3C7" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
