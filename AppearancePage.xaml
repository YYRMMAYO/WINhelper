<UserControl x:Class="WINHELP.AppearancePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WINHELP"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题色块卡片（玻璃感）：用 ListBox.ItemTemplate 渲染 -->
        <Style x:Key="ThemeSwatchCard" TargetType="Border">
            <Setter Property="Width" Value="138"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#20000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,18">
            <Border Width="44" Height="44" CornerRadius="12" Background="#EBF3FC" VerticalAlignment="Center">
                <TextBlock Text="🎨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="{loc:Loc 个性装扮|Appearance}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextOnDarkBrush}"/>
                <TextBlock Text="{loc:Loc 实时预览，点哪改哪|Live preview — click anywhere to change instantly}" FontSize="12" Foreground="{DynamicResource TextOnDarkBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 主题色块 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc 主题颜色|Theme Color}" FontSize="15" FontWeight="Bold"
                                           Foreground="#2C3E50" VerticalAlignment="Center"/>
                                <Border Background="#EBF3FC" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock x:Name="TxtSelectedName" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#2E86C1" Text="{loc:Loc 未选择|Not selected}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 用 ItemsControl + WrapPanel 展示所有色卡，星空渐变特殊渲染 -->
                        <ItemsControl x:Name="SwatchList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ThemeSwatchCard}"
                                            MouseLeftButtonDown="Swatch_Click"
                                            Tag="{Binding Key}">
                                        <Grid ClipToBounds="True">
                                            <!-- 底色 -->
                                            <Rectangle Fill="{Binding Brush}">
                                                <Rectangle.Clip>
                                                    <RectangleGeometry Rect="0,0,138,84" RadiusX="12" RadiusY="12"/>
                                                </Rectangle.Clip>
                                            </Rectangle>
                                            <!-- 星空渐变叠加层 -->
                                            <Rectangle Fill="{Binding OverlayBrush}" Visibility="{Binding StarVisibility}">
                                                <Rectangle.Clip>
                                                    <RectangleGeometry Rect="0,0,138,84" RadiusX="12" RadiusY="12"/>
                                                </Rectangle.Clip>
                                            </Rectangle>
                                            <!-- 星空主题的小白点装饰 -->
                                            <Canvas Visibility="{Binding StarVisibility}" IsHitTestVisible="False">
                                                <Ellipse Width="3" Height="3" Fill="White" Opacity="0.85" Canvas.Left="22" Canvas.Top="14"/>
                                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.65" Canvas.Left="55" Canvas.Top="32"/>
                                                <Ellipse Width="4" Height="4" Fill="White" Opacity="0.95" Canvas.Left="86" Canvas.Top="18"/>
                                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.55" Canvas.Left="112" Canvas.Top="48"/>
                                                <Ellipse Width="3" Height="3" Fill="White" Opacity="0.75" Canvas.Left="42" Canvas.Top="58"/>
                                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.6"  Canvas.Left="100" Canvas.Top="64"/>
                                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.5"  Canvas.Left="72" Canvas.Top="46"/>
                                            </Canvas>
                                            <!-- 标签 -->
                                            <Border Background="#88000000" CornerRadius="4"
                                                    Padding="8,3" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    Margin="8,0,0,8">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>
                                            <!-- 选中标记 -->
                                            <Border x:Name="SelectedMark" Visibility="Collapsed"
                                                    BorderBrush="White" BorderThickness="2" CornerRadius="12"
                                                    Background="#33000000">
                                                <TextBlock Text="✓" FontSize="22" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontSize="11" Foreground="#BDC3C7" Margin="0,4,0,0"
                                   Text="{loc:Loc 点击色卡立即应用。星空主题内置深色背景，玻璃面板自动加深以保证可读性。|Click a swatch to apply instantly. The starry theme has a built-in dark background; glass panels auto-darken for readability.}"/>
                    </StackPanel>
                </Border>

                <!-- 跟随系统主题 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc 跟随系统主题|Follow System Theme}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="{loc:Loc 开启后，软件随 Windows 浅色 / 深色模式自动切换（深色匹配星空主题）。手动选择主题色会关闭此选项。|When enabled, the app follows Windows Light/Dark mode automatically (Dark matches the starry theme). Manually selecting a theme color turns this off.}"/>
                        <CheckBox Name="ChkFollowSystem" Checked="FollowSystem_Changed" Unchecked="FollowSystem_Changed">
                            <TextBlock FontSize="13" Foreground="#34495E" Text="启用跟随系统主题"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 玻璃效果 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc 玻璃效果|Glass Effect}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,14"
                                   TextWrapping="Wrap" Text="{loc:Loc 调节毛玻璃的强度与模式，修改后主窗口实时预览。|Adjust the strength and mode of the frosted glass; the main window previews changes in real time.}"></TextBlock>

                        <!-- 玻璃模式 -->
                        <TextBlock Text="{loc:Loc 玻璃模式|Glass Mode}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Name="RadioTranslucent" GroupName="GlassMode"
                                         Content="{loc:Loc 半透明叠加（图片清晰）|Translucent overlay (clear image)}" Margin="0,0,18,0"
                                         Checked="GlassMode_Changed"/>
                            <RadioButton Name="RadioAcrylic" GroupName="GlassMode"
                                         Content="{loc:Loc 图片模糊（Acrylic）|Image blur (Acrylic)}"
                                         Checked="GlassMode_Changed"/>
                        </StackPanel>

                        <!-- 背景不透明度 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc 背景不透明度|Background Opacity}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtOpacity" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Name="SliderOpacity" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,14" ValueChanged="Opacity_ValueChanged"
                                Style="{StaticResource GlassSlider}"/>

                        <!-- 玻璃强度 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc 玻璃强度|Glass Intensity}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtGlass" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Name="SliderGlass" Minimum="40" Maximum="90" Value="65"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Glass_ValueChanged"
                                Style="{StaticResource GlassSlider}"/>
                    </StackPanel>
                </Border>

                <!-- 窗口背景 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc 窗口背景|Window Background}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,4"/>
                        <TextBlock
                                   FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="{loc:Loc 选择一张图片作为程序背景，将覆盖整个窗口（含侧边栏与状态栏）。星空主题下图片将被自动隐藏。|Choose an image as the app background; it covers the entire window (including sidebar and status bar). Under the starry theme the image is hidden automatically.}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Name="BackgroundPathBox" IsReadOnly="True"
                                     FontSize="12" VerticalAlignment="Center"
                                     Padding="10,6" Background="#EBEDF0" BorderThickness="0"
                                     Text="{loc:Loc 未选择图片|No image selected}"
                                     ToolTip="点击右侧按钮选择图片"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Style="{StaticResource ActionButton}"
                                        Content="{loc:Loc 选择图片|Select Image}" Background="#4A90D9" Width="90"
                                        Click="ChooseBackground_Click"/>
                                <Button Style="{StaticResource ActionButton}"
                                        Content="{loc:Loc 清除|Clear}" Background="#E74C3C" Width="60"
                                        Margin="8,0,0,0"
                                        Click="ClearBackground_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 背景预览 -->
                        <Border Name="PreviewBorder" CornerRadius="10" Height="120"
                                Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="PreviewBrush" Stretch="UniformToFill" Opacity="0.4"/>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 界面字体 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc 界面字体|Interface Font}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="{loc:Loc 选择一款中文常用且美观的字体，立即应用到整个软件界面，并自动保存。|Choose a common, elegant Chinese font to apply to the whole app instantly, with auto-save.}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbFont" Height="38" VerticalAlignment="Center"
                                      SelectionChanged="CmbFont_SelectionChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource ActionButton}"
                                    Content="{loc:Loc 恢复默认|Restore Default}" Background="#95A5A6" Width="90" Margin="10,0,0,0"
                                    Click="FontReset_Click"/>
                        </Grid>

                        <Border Margin="0,14,0,0" CornerRadius="10" Background="#F5F7FA" Padding="14,12">
                            <TextBlock x:Name="TxtFontPreview" Text="{loc:Loc 司南工具箱 · 让工具更优雅 Aa 123|SiNan Toolbox · Make tools elegant Aa 123}"
                                       FontSize="20" Foreground="#2C3E50" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11" Foreground="#95A5A6"
                       Text="{loc:Loc 所有改动已实时保存|All changes are saved in real time}"/>
            <Button Content="{loc:Loc 完成|Done}" Width="100" Height="36"
                    Style="{StaticResource ActionButton}"
                    Background="#4A90D9" Foreground="White"
                    Click="Done_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
