<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WINHELP">

    <!-- ============================================================
         液态玻璃主题样式表 (Liquid Glass Theme)
         所有样式通过 DynamicResource 引用 ThemeManager 的共享画刷单例，
         切换/拖动滑块时画刷 .Color 变化即实时全窗刷新。
         严禁使用 UIElement.Opacity 改透明度，会把子元素也变虚。
         ============================================================ -->

    <!-- 玻璃效果资源：阴影 + 模糊（v5.1.0：阴影整体减淡，更简洁干净） -->
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="16" ShadowDepth="1" Direction="270" Opacity="0.05"/>
    <BlurEffect x:Key="GlassBlur" Radius="30" KernelType="Gaussian"/>

    <!-- 卡片阴影别名（与 MainWindow 的 CardShadow 视觉一致）。
         放在 Application 级资源，使任意 UserControl 在构造函数阶段（尚未挂入可视化树、
         无法向上查找到 MainWindow.Resources）也能通过 FindResource("CardShadow") 取到，
         避免 AI 密钥获取教程等页面在构建卡片时抛 ResourceReferenceKeyNotFoundException 而崩溃。 -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="1" Direction="270" Opacity="0.05"/>

    <!-- 高光描边笔刷：1px 白色高光（用于玻璃卡边缘） -->
    <SolidColorBrush x:Key="GlassHighlight" Color="#80FFFFFF"/>

    <!-- 卡片/面板实边框（v5.1.0：浅灰实边更清晰，替代半透明白高光） -->
    <SolidColorBrush x:Key="CardBorder" Color="#E3E8EF"/>

    <!-- 描边浅色：用于卡片内细分割线 -->
    <SolidColorBrush x:Key="GlassDivider" Color="#20FFFFFF"/>

    <!-- 顶栏分隔线（深色模式） -->
    <SolidColorBrush x:Key="GlassDividerDark" Color="#15000000"/>

    <!-- ============================================================
         玻璃画刷默认值（兜底）
         与 ThemeManager 的共享画刷单例初始色一致。RegisterGlassResources()
         会在启动时用可实时刷新的单例覆盖这些键；若注册未执行，DynamicResource
         也能回退到此处的安全默认值，避免卡片因找不到画刷而变透明。
         ============================================================ -->
    <SolidColorBrush x:Key="GlassCardBrush" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="GlassTopBarBrush" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="GlassPillBrush" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="GlassSearchBrush" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="GlassNavHoverBrush" Color="#224A90D9"/>
    <SolidColorBrush x:Key="GlassNavActiveBrush" Color="#404AD0F5"/>

    <!-- v5.3.0 强调色兜底（ThemeManager.RegisterGlassResources 会在启动时注册实时刷新单例覆盖） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4A90D9"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4A90D9"/>
    <Color x:Key="AccentColor">#4A90D9</Color>
    <Color x:Key="DarkerColor">#3B77B5</Color>

    <!-- 语义文字画刷（O2 深色主题文字对比度）：随明暗主题自动反色。
         默认深色值（浅色玻璃表面上清晰可读）；星空/极光深色模式下由 ThemeManager.ApplyGlass
         翻为浅色。XAML 通过 DynamicResource 引用，切换主题即时刷新。 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#95A5A6"/>
    <SolidColorBrush x:Key="IconBrush" Color="#5F6B7A"/>
    <!-- 仅用于直接绘制在深色背景上的文字（星空/极光下翻为浅色），兜底深灰 -->
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#2C3E50"/>

    <!-- ============================================================
         玻璃卡片：用于内容区块 (HomePage 卡片、模块内容卡等)
         Background 引用共享画刷 GlassCardBrush（DynamicResource）
         ============================================================ -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
    </Style>

    <!-- 玻璃面板：用于大区块（顶栏、状态栏、设置页内面板） -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- 侧边栏：左侧导航（不带阴影、右侧描边分隔） -->
    <Style x:Key="GlassSidebar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSidebarBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassDividerDark}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- 顶栏：标题栏（带底部细描边） -->
    <Style x:Key="GlassTopBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassTopBarBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassDividerDark}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.04"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 搜索框外框：包裹图标+TextBox 的圆角容器 -->
    <Style x:Key="GlassSearchFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSearchBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Width" Value="240"/>
    </Style>

    <!-- 工具栏按钮：用于设置页底部按钮（带玻璃感） -->
    <Style x:Key="GlassToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 选中徽章（主题色选择后的高亮条） -->
    <Style x:Key="GlassSelectedBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassPillBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <!-- 通用半透明小卡：用在玻璃面板内的二级卡 (如"复制链接"卡) -->
    <Style x:Key="GlassInnerCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassPillBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- 设置页文本框（背景路径框） -->
    <Style x:Key="GlassPathBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{DynamicResource GlassPillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <!-- 状态指示灯卡片（设置页内 CPU/内存/网络用） -->
    <Style x:Key="GlassPillMini" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassPillBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- 浅色代码/输出面板（v5.1.0：替代纯黑控制台，蓝白清爽；用于端口/蓝屏/报告等只读输出） -->
    <Style x:Key="CodePanel" TargetType="TextBox">
        <Setter Property="Background" Value="#F7F9FB"/>
        <Setter Property="Foreground" Value="#3A4A5A"/>
        <Setter Property="BorderBrush" Value="#E3E8EF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsUndoEnabled" Value="False"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="CaretBrush" Value="#3A4A5A"/>
        <Setter Property="SelectionBrush" Value="#C9DDF3"/>
    </Style>

    <!-- ============================================================
         玻璃滚动条 / ScrollViewer（悬浮式，不占布局宽度）
         - 滚动条以半透明玻璃质感浮在右侧/底部边缘，平时自动隐藏，
           鼠标悬停（含滚轮滚动时）淡入，不遮挡内容点击。
         - ScrollViewer 模板将滚动条叠加在内容之上而非占用独立列宽。
         ============================================================ -->

    <!-- 滚动条轨道空白处（点击翻页）按钮：透明 -->
    <Style x:Key="GlassScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条滑块（Thumb）：v5.1.0 柔和浅灰蓝，hover 主色 -->
    <Style x:Key="GlassScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="#C9D4E0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#C9D4E0" CornerRadius="4"
                            Margin="2" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.15" Color="#2C3E50"/>
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#9FB6CC"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#4A90D9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条本体（隐式，全应用生效） -->
    <Style TargetType="ScrollBar">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}"
                               Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GlassScrollBarPageButton}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource GlassScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GlassScrollBarPageButton}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer（隐式，全应用生效）：滚动条悬浮叠加，不占布局宽度 -->
    <Style TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Content="{TemplateBinding Content}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Width="9"
                                   Opacity="0.35"
                                   IsHitTestVisible="True"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Style="{StaticResource {x:Type ScrollBar}}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Orientation="Horizontal"
                                   VerticalAlignment="Bottom"
                                   Height="9"
                                   Opacity="0.35"
                                   IsHitTestVisible="True"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Style="{StaticResource {x:Type ScrollBar}}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True"/>
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         玻璃滑块（Slider）：用于"个性装扮"模糊/透明度调节，拖动更顺滑现代
         ============================================================ -->
    <Style x:Key="GlassSliderFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" Background="#4A90D9" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSliderEmpty" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" Background="#D5DEE8" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑块缓动函数（用于拇指 hover/drag 动画，平滑收尾） -->
    <CubicEase x:Key="GlassEase" EasingMode="EaseOut"/>

    <Style x:Key="GlassSliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Dot" Width="18" Height="12" CornerRadius="4"
                            Background="White" BorderBrush="#4A90D9" BorderThickness="3">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                        <Border.Effect>
                            <DropShadowEffect x:Name="DotGlow" BlurRadius="3" ShadowDepth="0" Opacity="0.30" Color="#2C3E50"/>
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：平滑放大 + 高亮 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Dot" Property="Background" Value="#EAF2FB"/>
                            <Setter TargetName="Dot" Property="BorderBrush" Value="#3A7BC8"/>
                        </Trigger>
                        <!-- 拖动：外发光增强，提示"正在调节" -->
                        <Trigger Property="IsDragging" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotGlow" Storyboard.TargetProperty="BlurRadius" To="8" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotGlow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotGlow" Storyboard.TargetProperty="BlurRadius" To="3" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="DotGlow" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.18" EasingFunction="{StaticResource GlassEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Dot" Property="BorderBrush" Value="#2E6FB0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border Background="Transparent" VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource GlassSliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource GlassSliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource GlassSliderEmpty}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         QQ 风格窗口标题栏（半透明蓝渐变 + 自绘窗口按钮）
         配合 MainWindow 的 WindowChrome 使用：
         - 背景 QQCaptionBrush 为蓝色 alpha 0.80→0.60 渐变
         - QQCaptionButton 默认半透明白底，hover 白色高亮
         - QQCloseButton hover 红底 (#E81123)
         ============================================================ -->

    <!-- QQ 标题栏渐变背景：上深下浅，覆盖整个窗口顶部宽度（含关闭按钮区） -->
    <LinearGradientBrush x:Key="QQCaptionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC4A90D9" Offset="0"/>
        <GradientStop Color="#994A90D9" Offset="1"/>
    </LinearGradientBrush>

    <!-- 标题栏分隔线 -->
    <SolidColorBrush x:Key="QQCaptionBorder" Color="#15000000"/>

    <!-- ============================================================
         全局字体（个性装扮 → 字体模块）
         - AppFontFamily 默认微软雅黑，ThemeManager.ApplyFont() 会在启动时
           与切换字体时更新该资源；XAML 通过 DynamicResource 引用后实时刷新。
         - 隐式样式让 TextBlock / Control 默认继承该字体；FontFamily 是可继承属性，
           设置窗口根后会级联到所有未显式指定字体的子元素（含显式样式按钮）。
         ============================================================ -->
    <FontFamily x:Key="AppFontFamily">Microsoft YaHei</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="HeaderedContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <!-- 通用 caption 按钮：46×56，默认透明，hover 半透明白底 -->
    <Style x:Key="QQCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：hover 圆形红底 (#E81123)，X 字形居中高亮，更现代 -->
    <Style x:Key="QQCloseButton" TargetType="Button" BasedOn="{StaticResource QQCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 悬停时显形的圆形红底（默认透明，居中于 46×56 按钮区） -->
                        <Border x:Name="HoverCircle" Width="34" Height="34" CornerRadius="17"
                                Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverCircle" Property="Background" Value="#E81123"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverCircle" Property="Background" Value="#C40E1A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         全局按键点击动画（v4.0.0）
         - 隐式样式：所有未显式指定 Style 的 Button 自动获得 ClickAnim。
         - 显式指定了 Style 的按钮（如 GlassToolbarButton / QQCaptionButton 等）
           已通过 BasedOn="{StaticResource {x:Type Button}}" 继承本样式，从而也获得动画。
         - 行为本身只修改 RenderTransform（按压缩小 + 回弹放大），不影响外观。
         ============================================================ -->
    <Style TargetType="Button">
        <Setter Property="local:ClickAnim.IsEnabled" Value="True"/>
    </Style>

</ResourceDictionary>
