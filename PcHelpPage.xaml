<!-- 导航模块 key="help"：对应 PcHelpPage.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.PcHelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:WINHELP"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        

        <!-- 系统工具按钮样式 -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A90D9"/>
            <Setter Property="Background" Value="#EBF3FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E8FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 技巧卡片标题样式 -->
        <Style x:Key="TipTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TipBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💻" FontSize="20" VerticalAlignment="Center" Margin="0,-2,10,0"/>
                    <TextBlock Text="{loc:Loc '电脑帮助|PC Help'}" FontSize="20" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc '— Windows 实用指南|— Windows Practical Guide'}" FontSize="13"
                               Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <StackPanel Grid.Row="1">
                <!-- 系统信息 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc '🖥️ 系统信息|🖥️ System Information'}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc '操作系统|Operating System'}" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtOS" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc '系统位数|System Architecture'}" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtArch" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc '.NET 版本|.NET Version'}" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDotNet" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc '机器名称|Machine Name'}" FontSize="13"
                                       Foreground="#95A5A6" Margin="0,0,30,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtMachine" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统工具快捷入口 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc '⚙️ 系统工具 · 一键打开|⚙️ System Tools · One-Click Open'}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '📁 控制面板|📁 Control Panel'}" Click="Btn_ControlPanel"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '📊 任务管理器|📊 Task Manager'}" Click="Btn_TaskMgr"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🧹 磁盘清理|🧹 Disk Cleanup'}" Click="Btn_DiskCleanup"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '💾 磁盘管理|💾 Disk Management'}" Click="Btn_DiskMgmt"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🔧 设备管理器|🔧 Device Manager'}" Click="Btn_DevMgr"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🌐 网络连接|🌐 Network Connections'}" Click="Btn_Network"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '📋 剪贴板历史|📋 Clipboard History'}" Click="Btn_Clipboard"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🔋 电源选项|🔋 Power Options'}" Click="Btn_Power"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🖱️ 鼠标属性|🖱️ Mouse Properties'}" Click="Btn_Mouse"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🎨 显示设置|🎨 Display Settings'}" Click="Btn_Display"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🔊 声音设置|🔊 Sound Settings'}" Click="Btn_Sound"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🕒 日期时间|🕒 Date and Time'}" Click="Btn_DateTime"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🔤 输入法|🔤 Input Method'}" Click="Btn_Input"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '📦 程序和功能|📦 Programs and Features'}" Click="Btn_Programs"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🔒 Windows 安全|🔒 Windows Security'}" Click="Btn_Security"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🚀 系统信息|🚀 System Information'}" Click="Btn_SysInfo"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '⌨️ 屏幕键盘|⌨️ On-Screen Keyboard'}" Click="Btn_OSK"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '🔍 放大镜|🔍 Magnifier'}" Click="Btn_Magnifier"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '📸 截图工具|📸 Snipping Tool'}" Click="Btn_Snipping"/>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Loc '📧 邮件|📧 Mail'}" Click="Btn_Mail"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 常用快捷键 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc '⌨️ 常用快捷键速查|⌨️ Common Shortcuts'}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>

                        <WrapPanel>
                            <!-- 快捷键卡片 -->
                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '窗口管理|Window Management'}"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+D 显示桌面<LineBreak/>
                                        Win+Tab 任务视图<LineBreak/>
                                        Alt+Tab 切换窗口<LineBreak/>
                                        Win+↑/↓ 最大化/最小化
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '文件操作|File Operations'}"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+E 打开资源管理器<LineBreak/>
                                        Ctrl+C/V 复制/粘贴<LineBreak/>
                                        Ctrl+Z 撤销<LineBreak/>
                                        Ctrl+Shift+Esc 任务管理器
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '截图与录屏|Screenshot and Recording'}"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+Shift+S 区域截图<LineBreak/>
                                        PrtSc 全屏截图<LineBreak/>
                                        Win+G 游戏录制栏<LineBreak/>
                                        Win+Alt+R 开始/停止录制
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '搜索与运行|Search and Run'}"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win 搜索/开始菜单<LineBreak/>
                                        Win+R 运行对话框<LineBreak/>
                                        Win+S 搜索<LineBreak/>
                                        Win+I 设置
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '虚拟桌面|Virtual Desktops'}"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+Ctrl+D 新建桌面<LineBreak/>
                                        Win+Ctrl+←/→ 切换桌面<LineBreak/>
                                        Win+Ctrl+F4 关闭桌面
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8F9FA" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Width="220">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '其他实用|Other Useful'}"/>
                                    <TextBlock Style="{StaticResource TipBody}">
                                        Win+V 剪贴板历史<LineBreak/>
                                        Win+; 表情符号面板<LineBreak/>
                                        Win+L 锁屏<LineBreak/>
                                        Ctrl+Shift+N 新建文件夹
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 实用技巧 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc '💡 电脑实用技巧|💡 PC Practical Tips'}" FontSize="15" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,14"/>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '1. 加速开机启动|1. Speed Up Startup'}"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    打开任务管理器（Ctrl+Shift+Esc），切换到「启动」选项卡，
                                    禁用不需要开机自启的程序，可显著加快开机速度。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '2. 释放磁盘空间|2. Free Up Disk Space'}"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    定期使用「磁盘清理」工具清除临时文件和系统缓存。
                                    也可在设置 → 系统 → 存储中开启「存储感知」自动清理。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '3. 查看硬件信息|3. View Hardware Info'}"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    按 Win+R 输入 msinfo32 可打开系统信息窗口，
                                    查看处理器、内存、主板等详细硬件信息。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '4. 网络问题排查|4. Network Troubleshooting'}"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    网络不通时，按 Win+R 输入 cmd，再输入 ping www.baidu.com
                                    测试连通性。也可尝试 ipconfig /flushdns 刷新 DNS 缓存。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TipTitle}" Text="{loc:Loc '5. 安全模式启动|5. Start in Safe Mode'}"/>
                                <TextBlock Style="{StaticResource TipBody}">
                                    按住 Shift 点击重启，或设置 → 恢复 → 高级启动，
                                    可进入安全模式排查驱动或软件冲突问题。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
        </StackPanel>
    </Grid>
</UserControl>
