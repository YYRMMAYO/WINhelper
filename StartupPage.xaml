<UserControl x:Class="WINHELP.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Height="56" BorderBrush="#EDF0F3" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#FFF3E0" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="{loc:Loc 启动项管理|Startup Items}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc 禁用不必要的开机自启项，加快开机速度|Disable unnecessary startup items to speed up boot}" FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>

        <Border Style="{StaticResource GlassCard}" Grid.Row="2" Height="60" BorderBrush="#EDF0F3" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TxtStatus" Text="{loc:Loc 正在读取启动项…|Reading startup items…}" FontSize="12"
                           Foreground="#7F8C8D" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button x:Name="BtnRefresh" Content="{loc:Loc 刷新|Refresh}" Height="36" Width="100"
                        FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#4A90D9"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
