<Window x:Class="WINHELP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WINHELP"
        xmlns:loc="clr-namespace:WINHELP"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{loc:Loc 司南工具箱|Sinan Toolbox}" Height="820" Width="1100"
        MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#F0F2F5">

    <!-- WindowChrome：保留系统阴影 + 拖拽 + 任务栏缩略图（标题栏高度 48） -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                             GlassFrameThickness="1"
                             ResizeBorderThickness="6"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 轻量阴影：仅大卡 / 弹层使用，避免厚重 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="1" Direction="270" Opacity="0.06"/>
        <DropShadowEffect x:Key="PopShadow" BlurRadius="24" ShadowDepth="2" Direction="270" Opacity="0.10"/>

        <!-- ===== 导航项样式（v5.6.0：右侧导引栏，图标徽标 + 文字，激活指示条朝向内容区） ===== -->
        <Style x:Key="NavItemStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <!-- 激活指示条：位于按钮左侧、面向内容区 -->
                            <Border x:Name="ActiveIndicator" Width="3" Height="20"
                                    CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" Margin="1,0,0,0"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GlassNavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="local:NavProps.IsActive" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航选中样式：强调色浅底 + 强调色文字 -->
        <Style x:Key="NavItemActiveStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="Background" Value="{DynamicResource GlassNavActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 侧栏分组标题 -->
        <Style x:Key="NavGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="24,14,0,4"/>
        </Style>

        <!-- 标题栏按钮（Win11 风格：40×32 悬浮胶囊，悬停浅灰，关闭悬停红） -->
        <Style x:Key="CaptionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬停 Win11 红（#C42B1C）圆角底 + 白叉（字形随 Foreground 变色） -->
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A02315"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 玻璃模糊背景层 + 星空装饰层（v5.6.0：覆盖整窗含标题栏，避免 Acrylic/星空下顶栏仍是"白色默认框"） -->
        <Image x:Name="BackdropImage" Grid.RowSpan="2"
               Stretch="UniformToFill" Visibility="Collapsed"
               Effect="{StaticResource GlassBlur}"
               CacheMode="BitmapCache"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Canvas x:Name="StarryLayer" Grid.RowSpan="2" IsHitTestVisible="False"
                Background="Transparent" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- ===== 顶部标题栏（浅色，主题感知） ===== -->
        <Border Grid.Row="0" Name="CaptionBar" Style="{StaticResource GlassTopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource DarkerColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="司" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtBrand" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="TxtVersion" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 当前页标题 -->
                <TextBlock Grid.Column="1" x:Name="TxtPageTitle"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 右侧：搜索 + 一键优化 + 窗口按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 搜索框（浅色胶囊，矢量放大镜图标） -->
                    <Border Background="#12000000" CornerRadius="8" Margin="0,0,12,0" Height="32"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Data="M9,9 L14,14 M10.5,6 A4.5,4.5 0 1,1 1.5,6 A4.5,4.5 0 1,1 10.5,6"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBox Grid.Column="1" x:Name="TxtSearch" Width="150" Height="30" Margin="6,0,4,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     FontSize="12" VerticalContentAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"
                                     PreviewKeyDown="TxtSearch_PreviewKeyDown"
                                     ToolTip="{loc:Loc 搜索首页功能模块|Search home modules}"
                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </Grid>
                    </Border>

                    <!-- 一键优化 -->
                    <Button x:Name="BtnOptimize" Height="32" Margin="0,0,14,0"
                            FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Content="{loc:Loc 一键优化|One-click Optimize}" Padding="16,0"
                            Click="BtnOptimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <!-- 优化结果提示（完成后短暂显示，自动隐藏） -->
                    <TextBlock x:Name="TxtOptResult" FontSize="12" Foreground="#27AE60"
                               VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="240"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}"
                            Click="BtnMin_Click" ToolTip="{loc:Loc 最小化|Minimize}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"
                              Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}"
                            Click="BtnMax_Click" ToolTip="{loc:Loc 最大化 / 还原|Maximize / Restore}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Path x:Name="BtnMaxRestore" Data="M0,0 H10 V10 H0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"
                                  Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtn}"
                            Click="BtnClose_Click" ToolTip="{loc:Loc 关闭|Close}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                              Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="208"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧内容区 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 主内容滚动区（宽松留白） -->
                <ScrollViewer Grid.Row="1" Margin="30,24,30,24" VerticalScrollBarVisibility="Auto"
                              x:Name="MainScroll">
                    <ContentControl x:Name="PageHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>

            <!-- ===== 右侧导航（v5.6.0：导引栏移至右侧，图标徽标 + 文字） ===== -->
            <Border Grid.Column="1" Style="{StaticResource GlassSidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,10,0,10">
                        <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>

                    <!-- 底部版本信息 -->
                    <Border Grid.Row="1" Padding="16,10" BorderBrush="{DynamicResource GlassDividerDark}"
                            BorderThickness="0,1,0,0">
                        <TextBlock x:Name="TxtNavFooter" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 更新提示栏（紧贴标题栏下方，出现时把内容区整体下推） ===== -->
        <Border Name="UpdateBar" Grid.Row="0" Visibility="Collapsed"
                Panel.ZIndex="10" Margin="0,48,0,0" VerticalAlignment="Top"
                Background="#FFFDF7" BorderBrush="#F5C76E" BorderThickness="1"
                CornerRadius="10" Padding="16,10" Effect="{StaticResource PopShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#FFF3E0"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <Path Data="M15,3 A12,12 0 1,0 15,27 A12,12 0 1,0 15,3 M15,12 V18 M15,21.5 V22.5"
                          Stroke="#E67E22" StrokeThickness="1.8" Stretch="Uniform" Margin="5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="UpdateTitle" FontSize="13" FontWeight="SemiBold"
                               Foreground="#8A4B08" TextWrapping="Wrap"/>
                    <TextBlock Name="UpdateNotes" FontSize="12" Foreground="#A86B14"
                               TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="480"/>
                </StackPanel>
                <Button Grid.Column="2" Name="BtnDownload" Height="30" Width="80"
                        FontSize="12" FontWeight="SemiBold"
                        Background="#E67E22" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Content="{loc:Loc 下载页面|Download Page}" Margin="16,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnDownload_Click"/>
                <Button Grid.Column="3" Name="BtnUpdateNow" Height="30" Width="92"
                        FontSize="12" FontWeight="SemiBold"
                        Background="#27AE60" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Content="{loc:Loc 下载并安装|Download &amp; Install}" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnUpdateNow_Click"/>
                <Button Grid.Column="4" Name="BtnDismiss" Height="30" Width="60"
                        FontSize="12" Foreground="#A86B14"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Content="{loc:Loc 忽略|Dismiss}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnDismiss_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
