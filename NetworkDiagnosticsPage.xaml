<!-- 导航模块 key="net"：对应 NetworkDiagnosticsPage.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.NetworkDiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">

    <UserControl.Resources>
        

        <Style x:Key="ResultRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Height="56" BorderBrush="#EDF0F3" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#E1F5FE" VerticalAlignment="Center">
                        <TextBlock Text="📡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:Loc 网络诊断|Network Diagnostics}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="{loc:Loc 连通性检测、网卡状态、Ping 延迟与下行带宽测速|Connectivity check, adapter status, ping latency and download speed test}" FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>

        <Border Style="{StaticResource GlassCard}" Grid.Row="2" Height="60" BorderBrush="#EDF0F3" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TxtStatus" Text="{loc:Loc 点击下方按钮开始诊断或测速|Click the button below to start diagnosis or speed test}" FontSize="12"
                           Foreground="#7F8C8D" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnDiag" Content="{loc:Loc 开始诊断|Start Diagnosis}" Height="36" Width="120"
                            FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#00A896"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnDiag_Click"/>
                    <Button x:Name="BtnSpeed" Content="{loc:Loc 网络测速|Speed Test}" Height="36" Width="110"
                            FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#2980B9"
                            BorderThickness="0" Cursor="Hand" Click="BtnSpeed_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
