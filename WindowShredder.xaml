<UserControl x:Class="WINHELP.WindowShredder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="ItemRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#FDECEA" VerticalAlignment="Center">
                        <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Name="TxtTitle" Text="文件粉碎" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Name="TxtSub" Text="不可恢复地销毁文件 / 文件夹（多次随机覆写）" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 拖放区 -->
            <Border Name="DropArea" Grid.Row="0" Height="110" CornerRadius="12"
                    Style="{StaticResource GlassCard}" Margin="0,0,0,12"
                    AllowDrop="True" BorderBrush="#BBDDFB" BorderThickness="2" Cursor="Hand">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Name="TxtDrop" Text="📂 将文件 / 文件夹拖拽到此处" FontSize="15"
                               Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Name="BtnSelectFiles" Content="选择文件" Width="120" Height="34"
                                Style="{StaticResource GlassToolbarButton}" Margin="0,0,10,0" Click="BtnSelectFiles_Click"/>
                        <Button Name="BtnSelectFolder" Content="选择文件夹" Width="120" Height="34"
                                Style="{StaticResource GlassToolbarButton}" Click="BtnSelectFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 遍数滑块 -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="TxtPassesLabel" Text="粉碎遍数" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Name="PassSlider" Grid.Column="1" Minimum="1" Maximum="7" Value="3"
                            TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource GlassSlider}"
                            VerticalAlignment="Center"/>
                    <TextBlock Name="PassValue" Grid.Column="2" Text="3" FontSize="14" FontWeight="Bold"
                               Foreground="#4A90D9" VerticalAlignment="Center" Margin="12,0,0,0" Width="20"/>
                </Grid>
            </Border>

            <!-- 操作 -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Name="BtnShred" Grid.Column="0" Content="开始粉碎" Height="38"
                        Style="{StaticResource GlassToolbarButton}" HorizontalAlignment="Stretch" Click="BtnShred_Click"/>
                <Button Name="BtnClear" Grid.Column="1" Content="清空列表" Width="100" Height="38" Margin="10,0,0,0"
                        Style="{StaticResource GlassToolbarButton}" Background="#95A5A6" Click="BtnClear_Click"/>
            </Grid>

            <!-- 队列 -->
            <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="8" Margin="0,0,0,12">
                <ListBox Name="ListItems" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ItemRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}" FontSize="12.5" Foreground="#2C3E50"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding StatusColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 进度与状态 -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Name="Prog" Grid.Row="0" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="#E74C3C" Background="#ECEFF1" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1">
                    <TextBlock Name="TxtStatus" Text="就绪" FontSize="12.5" Foreground="#7F8C8D"/>
                    <TextBlock Name="TxtWarn" FontSize="11" Foreground="#E67E22" TextWrapping="Wrap" Margin="0,6,0,0">
                        注意：NTFS 压缩 / 稀疏文件可能被系统重定向写入新簇，随机覆写未必能彻底擦除原簇；固态硬盘(SSD)因磨损均衡同样存在此限制。本功能适用于机械硬盘上的普通文件。
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
