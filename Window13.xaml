<UserControl x:Class="WINHELP.Window13"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Height="56" BorderBrush="#EDF0F3" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#EDE7F6" VerticalAlignment="Center">
                        <TextBlock Text="🔧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="故障排查向导" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtSubtitle" Text="选择你遇到的问题，按步骤自行排查" FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>

        <Border Style="{StaticResource GlassCard}" Grid.Row="2" Height="60" BorderBrush="#EDF0F3" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="请选择问题类别" FontSize="12"
                       Foreground="#7F8C8D" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0"/>
        </Border>
    </Grid>
</UserControl>
