                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="💬 钉钉" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="企业协同办公平台" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.dingtalk.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📋 飞书" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="一站式协作办公" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.feishu.cn/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🏢 企业微信" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="企业即时通讯办公" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://work.weixin.qq.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📄 腾讯文档" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="在线多人协作文档" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://docs.qq.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📝 石墨文档" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="云端协作文档工具" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://shimo.im/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 通讯 / 会议 ============ -->
                <TextBlock Text="📞 通讯 / 会议" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📹 腾讯会议" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="高清视频会议" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://meeting.tencent.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎦 Zoom" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="云视频会议平台" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://zoom.us/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="💬 微信" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="即时通讯与支付" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://weixin.qq.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 压缩 / 解压 ============ -->
                <TextBlock Text="📦 压缩 / 解压" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📦 7-Zip" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="开源免费压缩解压" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.7-zip.org/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🗜️ Bandizip" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="高速压缩解压软件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.bandisoft.com/bandizip/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📚 WinRAR" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="经典压缩管理工具" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.win-rar.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 文本 / 编辑 ============ -->
                <TextBlock Text="✏️ 文本 / 编辑" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📃 Notepad++" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="轻量级代码编辑器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://notepad-plus-plus.org/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="💻 VS Code" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="免费跨平台编辑器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://code.visualstudio.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 截图 / 图像 ============ -->
                <TextBlock Text="🖼️ 截图 / 图像" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="✂️ Snipaste" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="截图 + 贴图利器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.snipaste.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎨 GIMP" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="开源图像编辑器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.gimp.org/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 远程 / 传输 ============ -->
                <TextBlock Text="🔗 远程 / 传输" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🖥️ TeamViewer" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="远程控制与协助" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.teamviewer.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🔗 AnyDesk" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="轻量远程桌面工具" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://anydesk.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="☁️ 百度网盘" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="云存储与文件传输" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://pan.baidu.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
