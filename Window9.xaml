                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📄 WPS Office" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="国产办公套件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.wps.cn/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📚 LibreOffice" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="免费开源办公套件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.libreoffice.org/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
