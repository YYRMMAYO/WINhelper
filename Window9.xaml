<UserControl x:Class="WINHELP.Window9"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="Transparent">

    <UserControl.Resources>
        

        <!-- 官网卡片中的"打开官网"按钮样式 -->
        <Style x:Key="SiteOpenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A90D9"/>
            <Setter Property="Background" Value="#EBF3FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E8FA"/>
                    <Setter Property="Foreground" Value="#2A6299"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分类标题样式 -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="4,18,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#EDE7F6" VerticalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="官网导航" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="日常工作 / 办公常用软件 · 官方直达" FontSize="12" Foreground="#95A5A6"/>
                    </StackPanel>
                </StackPanel>
                <Button Name="BtnBack" Height="36" Width="110"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        Content="← 返回首页"
                        HorizontalAlignment="Right" Click="Button_Click_Back"/>
            </Grid>
        </Border>

        <!-- 官网卡片区域（按分类排列，可滚动） -->
        <StackPanel Grid.Row="1">
                <!-- ============ 录屏 / 录音 ============ -->
                <TextBlock Text="🎥 录屏 / 录音" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎥 OBS Studio" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="免费开源录屏 / 直播推流" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://obsproject.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎬 Bandicam" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="轻量高清屏幕录像" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.bandicam.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="📸 ShareX" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="截图 / 录屏 / 分享全能" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://getsharex.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎞️ ScreenToGif" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="屏幕录制转 GIF 动图" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.screentogif.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎬 Camtasia" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="录屏 + 视频剪辑一体" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.techsmith.com/camtasia.html" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎙️ Audacity" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="专业免费音频录制编辑" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.audacityteam.org/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎧 Ocenaudio" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="跨平台音频编辑工具" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.ocenaudio.com/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Width="210" Height="120" CornerRadius="12" Margin="0,0,12,12">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="🎚️ Adobe Audition" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="专业数字音频工作站" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.adobe.com/products/audition.html" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 办公 / 文档 ============ -->
