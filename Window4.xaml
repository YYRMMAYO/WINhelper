<UserControl x:Class="WINHELP.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">

    <UserControl.Resources>
        
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="40" ShadowDepth="4" Direction="270" Opacity="0.15"/>

        <!-- 自定义开关样式 -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextBlock.FontSize="14"
                                                  TextBlock.FontWeight="SemiBold"
                                                  TextBlock.Foreground="#2C3E50"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="50" Height="28" CornerRadius="14"
                                    x:Name="SwitchTrack" Background="#D5D8DC"
                                    VerticalAlignment="Center">
                                <Border x:Name="SwitchThumb" Width="24" Height="24"
                                        CornerRadius="12" Background="White"
                                        HorizontalAlignment="Left" Margin="2,0,0,0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.25"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#4A90D9"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 窗口主体 -->
    <Border x:Name="RootBorder" Background="Transparent" CornerRadius="16" Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Border Grid.Row="0" Height="54" CornerRadius="16,16,0,0"
                    Background="#FAFBFC" BorderBrush="#EDF0F3" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="18" VerticalAlignment="Center" Margin="0,-2,8,0"/>
                        <TextBlock x:Name="TxtSettingsTitle" Text="软件设置" FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Content="✕" FontSize="14"
                            Width="32" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="#95A5A6"
                            BorderThickness="0" Cursor="Hand"
                            Style="{x:Null}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- ===== 滚动内容区 ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,10">
                <StackPanel>
                    <!-- ===== 通用设置 ===== -->
                    <Border Background="#F8F9FA" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtGeneralTitle" Text="🚀 通用设置" FontSize="15" FontWeight="Bold"
                                       Foreground="#2C3E50" Margin="0,0,0,16"/>

                            <!-- 界面语言 -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtLangLabel" Text="界面语言" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtLangHint" FontSize="12" Foreground="#95A5A6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="CmbLanguage" Width="120" Height="34"
                                              VerticalAlignment="Center" Margin="0,0,0,0"
                                              SelectionChanged="CmbLanguage_Changed">
                                        <ComboBoxItem x:Name="CmbLangZh" Content="中文"/>
                                        <ComboBoxItem x:Name="CmbLangEn" Content="English"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- 开机自动启动 -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtAutoStart" Text="开机自动启动" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtAutoStartHint" Text="软件启动后自动引导系统，开机即用"
                                                   FontSize="12" Foreground="#95A5A6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ToggleAutoStart"
                                              Style="{StaticResource ModernToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>
                            </Border>

                            <!-- 启动时自动检查更新 -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtAutoCheck" Text="启动时自动检查更新" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtAutoCheckHint" Text="打开软件时自动检查是否有新版本"
                                                   FontSize="12" Foreground="#95A5A6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ToggleAutoCheckUpdate"
                                              Style="{StaticResource ModernToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>
                            </Border>

                            <!-- 关闭到系统托盘 -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtCloseTray" Text="关闭到系统托盘" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtCloseTrayHint" Text="点击关闭按钮时最小化到托盘而非退出程序"
                                                   FontSize="12" Foreground="#95A5A6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ToggleCloseToTray"
                                              Style="{StaticResource ModernToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== 定时计划 ===== -->
                    <Border Background="#F8F9FA" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtSchedulerTitle" Text="⏰ 定时计划" FontSize="15" FontWeight="Bold"
                                       Foreground="#2C3E50" Margin="0,0,0,16"/>

                            <!-- 启用定时自动优化 -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtEnableScheduler" Text="启用定时自动优化" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtSchedulerHint" FontSize="12" Foreground="#95A5A6"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ToggleSchedulerEnabled"
                                              Style="{StaticResource ModernToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="Scheduler_Changed" Unchecked="Scheduler_Changed"/>
                                </Grid>
                            </Border>

                            <!-- 执行频率 + 执行时间 -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="TxtDayLabel" Text="执行频率"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox Grid.Column="1" x:Name="ComboDay"
                                              SelectionChanged="Scheduler_Changed"
                                              VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ComboBoxItem x:Name="CbDaily" Content="每天"/>
                                        <ComboBoxItem x:Name="CbMon" Content="周一"/>
                                        <ComboBoxItem x:Name="CbTue" Content="周二"/>
                                        <ComboBoxItem x:Name="CbWed" Content="周三"/>
                                        <ComboBoxItem x:Name="CbThu" Content="周四"/>
                                        <ComboBoxItem x:Name="CbFri" Content="周五"/>
                                        <ComboBoxItem x:Name="CbSat" Content="周六"/>
                                        <ComboBoxItem x:Name="CbSun" Content="周日"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2" x:Name="TxtTimeLabel" Text="执行时间"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="3" x:Name="TxtTime" Text="03:00"
                                             VerticalAlignment="Center" Width="90" HorizontalAlignment="Left"
                                             Padding="6,4" BorderBrush="#D5D8DC" BorderThickness="1"
                                             TextChanged="Scheduler_Changed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== 关于与版本 ===== -->
                    <Border Background="#F8F9FA" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock x:Name="TxtAboutTitle" Text="ℹ️ 关于与版本" FontSize="15" FontWeight="Bold"
                                       Foreground="#2C3E50" Margin="0,0,0,16"/>

                            <!-- 版本信息卡片（增强：更清晰） -->
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="18,16" Margin="0,0,0,10"
                                    Background="#EBF5FB">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 左：版本图标 -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                            Background="#4A90D9" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock x:Name="TxtVersionLabel" Text="当前版本" FontSize="12"
                                                   Foreground="#5D6D7E"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtVersion"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="#2E86C1" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtFullVersion" FontSize="11" Foreground="#95A5A6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="BtnCheckUpdate"
                                            Content="🔍 检查更新" FontSize="12" FontWeight="SemiBold"
                                            Foreground="White" Background="#27AE60"
                                            BorderThickness="0" Cursor="Hand"
                                            Width="90" Height="34" VerticalAlignment="Center"
                                            Click="BtnCheckUpdate_Click"/>
                                </Grid>
                            </Border>

                            <!-- 版本历史（升级后保留原版本信息） -->
                            <Border x:Name="VersionHistoryCard" Margin="0,10,0,0"
                                    CornerRadius="10" Padding="16,14"
                                    Background="#F8F9FA" BorderBrush="#EDF0F3" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🕓" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtHistoryTitle" Text="版本历史" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel x:Name="VersionHistoryPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 更新状态栏（始终可见，未检查时显示提示） -->
                            <Border x:Name="UpdateStatusBar" Margin="0,10,0,0"
                                    CornerRadius="8" Padding="12,10" BorderBrush="#E8F5E9" BorderThickness="1"
                                    Background="#F8FFF8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " FontSize="12"/>
                                        <TextBlock x:Name="TxtUpdateStatus" FontSize="12" Foreground="#2E7D32"
                                                   TextWrapping="Wrap" Text="点击「检查更新」获取最新版本信息"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtLastCheckTime" FontSize="11" Foreground="#95A5A6" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                                    <Separator Background="#EDF0F3" Margin="0,4,0,10"/>

                                    <!-- GitHub -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtRepoLabel" Text="代码仓库" FontSize="13"
                                                   Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="13" Foreground="#4A90D9"
                                               VerticalAlignment="Center" Cursor="Hand"
                                               TextDecorations="Underline"
                                               Text="github.com/YYRMMAYO/WINhelper"
                                               MouseLeftButtonDown="GitHubLink_Click"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtDownloadLabel" Text="下载页面" FontSize="13"
                                                   Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" FontSize="13" Foreground="#4A90D9"
                                                   VerticalAlignment="Center" Cursor="Hand"
                                                   TextDecorations="Underline"
                                                   Text="蓝奏云下载"
                                                   MouseLeftButtonDown="DownloadLink_Click"/>
                                    </Grid>

                                    <!-- 开发者信息 -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="开发者" FontSize="13"
                                                   Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#2C3E50" VerticalAlignment="Center"
                                                   Text="YYRMM"/>
                                    </Grid>

                                    <!-- 非盈利声明 -->
                                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,10"
                                            Background="#E8F5E9">
                                        <TextBlock FontSize="12" Foreground="#2E7D32"
                                                   TextWrapping="Wrap">本软件完全免费，不盈利，仅供学习与交流使用，请勿用于商业用途。</TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
            </ScrollViewer>

            <!-- ===== 底部按钮栏 ===== -->
            <Border Grid.Row="2" Height="60" CornerRadius="0,0,16,16"
                    Background="#FAFBFC" BorderBrush="#EDF0F3" BorderThickness="0,1,0,0">
                <Button x:Name="BtnDone" Content="✔ 完成" FontSize="14" FontWeight="SemiBold"
                        Width="100" Height="36"
                        Foreground="White" Background="#4A90D9"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Right" Margin="0,0,20,0"
                        Click="BtnDone_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
