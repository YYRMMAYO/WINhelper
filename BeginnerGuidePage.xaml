<UserControl x:Class="WINHELP.BeginnerGuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">

    <UserControl.Resources>
        

        <Style x:Key="TipCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" Height="56" BorderBrush="#EDF0F3" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#EBF3FC" VerticalAlignment="Center">
                        <TextBlock Text="📘" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:Loc 新手导览|Beginner Guide}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="{loc:Loc 小白也能看懂的 司南工具箱 使用指南|A Sinan Toolbox user guide anyone can understand}" FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" Margin="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 欢迎语 -->
                <Border Style="{StaticResource TipCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc 👋 欢迎使用 司南工具箱|👋 Welcome to Sinan Toolbox}" FontSize="17" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap" LineHeight="22">
                            司南工具箱 是一款面向电脑小白的日常工具箱。左侧导航栏可以快速进入各个功能，
                            主页卡片则把常用入口都摆在眼前。遇到困难时，记得试试「故障排查向导」和「Agent 助手」。
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 功能导览 -->
                <TextBlock Text="{loc:Loc 主要功能一览|Feature Overview}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="4,8,0,12"/>

                <Border Style="{StaticResource TipCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#E8F5E9" Margin="0,0,14,0">
                            <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 系统清理 · C 盘|System Cleanup · Drive C}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc 帮你扫描临时文件、找出大文件，安全清理释放空间。|Scans temp files, finds large files, and safely cleans to free up space.}" FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource TipCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#FFF3E0" Margin="0,0,14,0">
                            <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 启动项管理|Startup Manager}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc 查看开机自启程序，禁用不必要的项目，让电脑开机更快。|View startup programs, disable unnecessary ones to speed up boot.}" FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource TipCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#E1F5FE" Margin="0,0,14,0">
                            <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 网络诊断|Network Diagnostics}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc 一键检测网络连通性、Ping 延迟、DNS 解析，快速定位网络问题。|One-click network connectivity check, Ping latency, and DNS resolution to quickly locate network issues.}" FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource TipCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#EDE7F6" Margin="0,0,14,0">
                            <TextBlock Text="🔧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 故障排查向导|Troubleshooting Wizard}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc 选择你遇到的问题，按步骤提示自行排查，省时省力。|Select your issue and follow step-by-step prompts to troubleshoot, saving time and effort.}" FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 每日贴士专区 -->
                <TextBlock Text="{loc:Loc 每日使用贴士|Daily Tips}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="4,16,0,12"/>
                <Border Style="{StaticResource TipCard}" Background="#FFFBEA">
                    <StackPanel>
                        <TextBlock x:Name="TxtTip" FontSize="14" Foreground="#2C3E50" TextWrapping="Wrap" LineHeight="22"
                                   Text="{loc:Loc 按 Win+D 可快速显示桌面，再次按可恢复窗口。|Press Win+D to quickly show the desktop; press again to restore windows.}"/>
                        <Button x:Name="BtnNextTip" Content="{loc:Loc 换一条贴士|Next Tip}" Height="32" Width="110" Margin="0,14,0,0"
                                FontSize="12" FontWeight="SemiBold" Foreground="White" Background="#4A90D9"
                                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
                                Click="BtnNextTip_Click"/>
                    </StackPanel>
                </Border>

                <!-- 常用快捷键 -->
                <TextBlock Text="{loc:Loc 常用快捷键|Common Shortcuts}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="4,16,0,12"/>
                <WrapPanel>
                    <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="14" Width="240" Margin="0,0,12,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc 窗口操作|Window Operations}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <Button HorizontalAlignment="Right" Content="{loc:Loc 📋 复制|📋 Copy}" FontSize="11"
                                        Foreground="#4A90D9" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="6,2" VerticalAlignment="Center"
                                        Tag="Win+D 显示桌面&#x0a;Alt+Tab 切换窗口&#x0a;Win+↑/↓ 最大化/还原"
                                        Click="BtnCopyShortcuts_Click"/>
                            </Grid>
                            <TextBlock FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap">
                                Win+D 显示桌面<LineBreak/>
                                Alt+Tab 切换窗口<LineBreak/>
                                Win+↑/↓ 最大化/还原
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="14" Width="240" Margin="0,0,12,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc 文件与搜索|Files &amp; Search}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <Button HorizontalAlignment="Right" Content="{loc:Loc 📋 复制|📋 Copy}" FontSize="11"
                                        Foreground="#4A90D9" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="6,2" VerticalAlignment="Center"
                                        Tag="Win+E 资源管理器&#x0a;Win+S 搜索&#x0a;Ctrl+Shift+N 新建文件夹"
                                        Click="BtnCopyShortcuts_Click"/>
                            </Grid>
                            <TextBlock FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap">
                                Win+E 资源管理器<LineBreak/>
                                Win+S 搜索<LineBreak/>
                                Ctrl+Shift+N 新建文件夹
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="14" Width="240" Margin="0,0,12,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc 截图与工具|Screenshot &amp; Tools}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <Button HorizontalAlignment="Right" Content="{loc:Loc 📋 复制|📋 Copy}" FontSize="11"
                                        Foreground="#4A90D9" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="6,2" VerticalAlignment="Center"
                                        Tag="Win+Shift+S 截图&#x0a;Win+V 剪贴板历史&#x0a;Ctrl+Shift+Esc 任务管理器"
                                        Click="BtnCopyShortcuts_Click"/>
                            </Grid>
                            <TextBlock FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap">
                                Win+Shift+S 截图<LineBreak/>
                                Win+V 剪贴板历史<LineBreak/>
                                Ctrl+Shift+Esc 任务管理器
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="2" Height="56" BorderBrush="#EDF0F3" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TxtStatus" Text="{loc:Loc 有问题随时打开「故障排查向导」或「电脑帮助」|Open the Troubleshooting Wizard or PC Help anytime if you have questions.}" FontSize="12"
                           Foreground="#7F8C8D" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button x:Name="BtnDone" Content="{loc:Loc 我知道了|Got it}" Height="36" Width="120"
                        FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#4A90D9"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                        Click="BtnDone_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
