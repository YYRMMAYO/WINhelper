<!-- 导航模块 key="tutorial"：对应 WindowTutorial.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.WindowTutorial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:loc="clr-namespace:WINHELP"
        Background="Transparent">

    <UserControl.Resources>
        
        <Style x:Key="TutBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#EDE7F6" VerticalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:Loc AI 密钥获取教程|AI API Key Tutorial}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="{loc:Loc 按步骤申请各大 AI 平台的 API 密钥，一键填入即可使用|Apply for API keys from major AI platforms step by step, then fill in with one click.}" FontSize="11" Foreground="#95A5A6"/>
                    </StackPanel>
                </StackPanel>
                <Button Name="BtnBack" Height="34" Width="100" FontSize="12" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" Cursor="Hand" Content="{loc:Loc ← 返回|← Back}"
                        Click="Button_Back_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 教程列表（卡片由代码生成） -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="1" CornerRadius="12" Padding="16">
            <StackPanel Name="PanelProviders" Margin="0,4"/>
        </Border>
    </Grid>
</UserControl>
