                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🎬 OBS Studio" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="开源直播 / 录屏软件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
