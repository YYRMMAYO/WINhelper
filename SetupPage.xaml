<!-- 导航模块 key="setup"：对应 SetupPage.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.SetupPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WINHELP"
        xmlns:loc="clr-namespace:WINHELP"
        mc:Ignorable="d"
        Background="Transparent">

    <UserControl.Resources>

        <!-- 单条软件卡片样式：宽 220 高 116，圆角 12 -->
        <Style x:Key="SetupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="116"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="local:ClickAnim.IsEnabled" Value="True"/>
            <Setter Property="local:ClickAnim.HoverScale" Value="1.03"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- "打开官网"按钮：与 OfficialSitesPage 视觉一致 -->
        <Style x:Key="SiteOpenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A90D9"/>
            <Setter Property="Background" Value="#EBF3FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E8FA"/>
                    <Setter Property="Foreground" Value="#2A6299"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分类标题 -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="4,18,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏介绍卡 -->
        <Border Style="{StaticResource GlassCard}" Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="9" Background="#E3F2FD" VerticalAlignment="Center">
                    <TextBlock Text="💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{loc:Loc '装机助手|Setup Assistant'}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="{loc:Loc '新电脑装机常用软件 · 全部为官方网站，无广告 / 捆绑|Essential software for a new PC · All official sites, no ads / bundles'}" FontSize="12" Foreground="#95A5A6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 软件列表区（可滚动，外层 MainScroll 兜底也能滚） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 由 SetupPage.xaml.cs 依据 SiteCatalog 动态填充各分类与卡片 -->
                <StackPanel x:Name="ContentStack"/>

                <!-- 底部说明 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="14,10" Margin="0,8,0,4">
                    <TextBlock FontSize="11.5" Foreground="#95A5A6" TextWrapping="Wrap">
                        <Run Text="{loc:Loc '💡 所有链接均为软件官方网站，点击按钮即可在默认浏览器打开。|💡 All links lead to official software websites. Click a button to open it in your default browser.'}"/>
                        <LineBreak/>
                        <Run Text="{loc:Loc '提示：本软件不捆绑任何第三方软件，请放心使用。|Tip: This app bundles no third-party software. Feel free to use it.'}" FontWeight="SemiBold" Foreground="#4A90D9"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
