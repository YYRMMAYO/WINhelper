                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🦊 Firefox" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc '开源隐私友好浏览器|Open-source privacy-friendly browser'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="{loc:Loc '打开官网|Open Website'}" Tag="https://www.mozilla.org/zh-CN/firefox" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
