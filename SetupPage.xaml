                            <TextBlock Text="{loc:Loc '国产免费办公套件|Free domestic office suite'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="{loc:Loc '打开官网|Open Website'}" Tag="https://www.wps.cn" Click="OpenSite_Click"/>
