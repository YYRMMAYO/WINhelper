                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="💬 QQ" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="腾讯即时通讯软件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://im.qq.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="💚 微信" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="国民社交 / 移动支付" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://weixin.qq.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🏢 企业微信" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="企业沟通与协同办公" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://work.weixin.qq.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="📞 钉钉" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="阿里巴巴团队协作平台" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.dingtalk.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🚀 飞书" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="字节跳动办公协作套件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.feishu.cn" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="📺 哔哩哔哩" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
