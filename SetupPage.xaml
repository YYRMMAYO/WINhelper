                            <Button Style="{StaticResource SiteOpenButton}" Content="{loc:Loc '打开官网|Open Website'}" Tag="https://www.tbtool.cn/" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🇨🇳 联想官网" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc '联想电脑驱动 / 售后支持|Lenovo PC drivers / after-sales support'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
