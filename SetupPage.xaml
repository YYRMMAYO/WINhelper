                            <TextBlock Text="{loc:Loc '腾讯游戏平台|Tencent gaming platform'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="{loc:Loc '打开官网|Open Website'}" Tag="https://www.wegame.com.cn" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🎥 PotPlayer" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="{loc:Loc '轻量强大的视频播放器|Lightweight and powerful video player'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
