                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.lenovo.com.cn" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="⬛ 戴尔官网" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="戴尔电脑驱动 / 技术支持" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.dell.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 🌐 浏览器与办公 ============ -->
                <TextBlock Text="🌐 浏览器与办公" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🟡 Google Chrome" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="全球最流行的浏览器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.google.cn/chrome" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🟦 Microsoft Edge" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="Win11 内置 Chromium 内核" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.microsoft.com/edge" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🦊 Firefox" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="开源隐私友好浏览器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.mozilla.org/zh-CN/firefox" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="📄 Microsoft 365" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="Word / Excel / PowerPoint" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.microsoft.com/microsoft-365" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="📝 WPS Office" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="国产免费办公套件" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.wps.cn" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="📦 7-Zip" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="开源免费压缩 / 解压" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://www.7-zip.org" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="⌨️ 搜狗输入法" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="智能词库中文输入法" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://pinyin.sogou.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🎥 腾讯会议" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="高清流畅的视频会议" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://meeting.tencent.com" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ============ 🎬 影音工具 ============ -->
                <TextBlock Text="🎬 影音与工具" Style="{StaticResource GroupHeader}"/>
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🎮 Steam" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="全球最大 PC 游戏平台" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://store.steampowered.com" Click="OpenSite_Click"/>
