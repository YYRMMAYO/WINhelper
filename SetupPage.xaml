                            <TextBlock Text="轻量强大的视频播放器" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://potplayer.daum.net" Click="OpenSite_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetupCard}">
                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="🎵 网易云音乐" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="音乐 / 歌单 / 播客" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource SiteOpenButton}" Content="打开官网" Tag="https://music.163.com" Click="OpenSite_Click"/>
