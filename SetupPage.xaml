                    </Border>
                </WrapPanel>

                <!-- 底部说明 -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="14,10" Margin="0,8,0,4">
                    <TextBlock FontSize="11.5" Foreground="#95A5A6" TextWrapping="Wrap">
                        <Run Text="💡 所有链接均为软件官方网站，点击按钮即可在默认浏览器打开。"/>
