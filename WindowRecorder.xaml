<UserControl x:Class="WINHELP.WindowRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WINHELP"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>

        <!-- 录制文件行 -->
        <Style x:Key="MediaRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 主色渐变（按钮 / 指示条） -->
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5AA0E6" Offset="0"/>
            <GradientStop Color="#3A7BC8" Offset="1"/>
        </LinearGradientBrush>

        <!-- 顶部英雄横幅渐变 -->
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A90D9" Offset="0"/>
            <GradientStop Color="#356BB0" Offset="1"/>
        </LinearGradientBrush>

        <!-- REC 脉冲动画：录音 / 录像时红点呼吸 -->
        <Storyboard x:Key="RecPulse">
            <DoubleAnimation Storyboard.TargetName="RecDotAudio" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.2" Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="RecDotScreen" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.2" Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="RecDotAudio" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.35" Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="RecDotAudio" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.35" Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="RecDotScreen" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.35" Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="RecDotScreen" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.35" Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>

            <!-- ===== 顶部英雄横幅 ===== -->
            <Border Padding="22,18" Margin="0,0,0,16" CornerRadius="16" Background="{StaticResource HeroBrush}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="50" Height="50" CornerRadius="16" Background="#26FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="🎙️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Name="TxtTitle" Text="录音录像" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Name="TxtSub" Text="麦克风录音与屏幕录像，录制文件保存在本地" FontSize="12.5" Foreground="#DCEBFA" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 模式切换（分段控件 + 滑动指示） ===== -->
            <Border x:Name="ModeTrack" Height="46" CornerRadius="23" Background="#E6ECF3"
                    Margin="0,0,0,16" SnapsToDevicePixels="True">
                <Grid>
                    <Border x:Name="ModeThumb" CornerRadius="23" Background="{StaticResource AccentGrad}"
                            HorizontalAlignment="Left" Width="0" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.25" Color="#2E6FB0"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ModeThumbX"/>
                        </Border.RenderTransform>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="BtnModeAudio" Grid.Column="0" Content="🎙️ 录音"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="14.5" FontWeight="SemiBold" Foreground="White" Click="BtnModeAudio_Click"/>
                        <Button Name="BtnModeScreen" Grid.Column="1" Content="🎥 录像"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="14.5" FontWeight="SemiBold" Foreground="#5F6B7A" Click="BtnModeScreen_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 录音面板 ===== -->
            <StackPanel Name="PanelAudio">
                <Border Style="{StaticResource GlassCard}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" CornerRadius="22" Background="#FDECEA" VerticalAlignment="Center">
                            <TextBlock Name="AudioIcon" Text="🎙️" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Name="RecDotAudio" Width="11" Height="11" Fill="#E74C3C" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform CenterX="5.5" CenterY="5.5" ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Name="TxtAudioState" Text="未开始" FontSize="19" FontWeight="Bold" Foreground="#2C3E50"/>
                            </StackPanel>
                            <TextBlock Name="TxtAudioTimer" Text="00:00" FontSize="30" FontWeight="Bold"
                                       Foreground="#4A90D9" FontFamily="Consolas, Menlo, monospace" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="BtnAudioStart" Grid.Column="0" Content="● 开始录音" Height="44"
                            Style="{StaticResource GlassToolbarButton}" Margin="0,0,7,0" Click="BtnAudioStart_Click"/>
                    <Button Name="BtnAudioStop" Grid.Column="1" Content="■ 停止并保存" Height="44"
                            Style="{StaticResource GlassToolbarButton}" Background="#95A5A6" Margin="7,0,0,0" IsEnabled="False" Click="BtnAudioStop_Click"/>
                </Grid>

                <Border Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保存位置" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Name="TxtAudioFolder" Grid.Column="1" Height="34" VerticalContentAlignment="Center" IsReadOnly="True"
                                 BorderBrush="#D5DBE0" BorderThickness="1" Background="#F7F9FB" Foreground="#5F6B7A"/>
                        <Button Name="BtnAudioBrowse" Grid.Column="2" Content="浏览" Width="82" Height="34" Margin="10,0,0,0"
                                Style="{StaticResource GlassToolbarButton}" Click="BtnAudioBrowse_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="已录制的音频" Style="{StaticResource SectionTitle}" Margin="4,4,0,10"/>
                <Border Style="{StaticResource GlassCard}" Padding="8" MinHeight="90">
                    <ListBox Name="ListAudio" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MediaRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#2C3E50" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="打开" Tag="{Binding Path}" Width="64" Height="28" Margin="8,0,0,0"
                                                Style="{StaticResource GlassToolbarButton}" Click="OpenItem_Click"/>
                                        <Button Grid.Column="2" Content="文件夹" Tag="{Binding Path}" Width="64" Height="28" Margin="8,0,0,0"
                                                Style="{StaticResource GlassToolbarButton}" Background="#95A5A6" Click="OpenFolder_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- ===== 录像面板 ===== -->
            <StackPanel Name="PanelScreen" Visibility="Collapsed">
                <Border Style="{StaticResource GlassCard}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" CornerRadius="22" Background="#EAF7EE" VerticalAlignment="Center">
                            <TextBlock Name="ScreenIcon" Text="🎥" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Name="RecDotScreen" Width="11" Height="11" Fill="#E74C3C" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform CenterX="5.5" CenterY="5.5" ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Name="TxtScreenState" Text="未开始" FontSize="19" FontWeight="Bold" Foreground="#2C3E50"/>
                            </StackPanel>
                            <TextBlock Name="TxtScreenTimer" Text="00:00" FontSize="30" FontWeight="Bold"
                                       Foreground="#4A90D9" FontFamily="Consolas, Menlo, monospace" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="BtnScreenStart" Grid.Column="0" Content="● 开始录像" Height="44"
                            Style="{StaticResource GlassToolbarButton}" Margin="0,0,7,0" Click="BtnScreenStart_Click"/>
                    <Button Name="BtnScreenStop" Grid.Column="1" Content="■ 停止" Height="44"
                            Style="{StaticResource GlassToolbarButton}" Background="#95A5A6" Margin="7,0,0,0" IsEnabled="False" Click="BtnScreenStop_Click"/>
                </Grid>

                <Border Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="TxtFpsLabel" Text="帧率" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider Name="FpsSlider" Grid.Column="1" Minimum="0" Maximum="3" Value="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Style="{StaticResource GlassSlider}" VerticalAlignment="Center"/>
                            <TextBlock Name="FpsValue" Grid.Column="2" Text="10 fps" FontSize="14" FontWeight="Bold" Foreground="#4A90D9" VerticalAlignment="Center" Margin="12,0,0,0" Width="56"/>
                        </Grid>
                        <CheckBox Name="ChkCursor" Content="捕获鼠标指针" FontSize="13" Foreground="#2C3E50" IsChecked="True" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtScreenHint" Text="提示：录像时建议先最小化本窗口，以免把工具箱本身也录进去。" FontSize="11.5" Foreground="#E67E22" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保存位置" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Name="TxtScreenFolder" Grid.Column="1" Height="34" VerticalContentAlignment="Center" IsReadOnly="True"
                                 BorderBrush="#D5DBE0" BorderThickness="1" Background="#F7F9FB" Foreground="#5F6B7A"/>
                        <Button Name="BtnScreenBrowse" Grid.Column="2" Content="浏览" Width="82" Height="34" Margin="10,0,0,0"
                                Style="{StaticResource GlassToolbarButton}" Click="BtnScreenBrowse_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="已录制的视频" Style="{StaticResource SectionTitle}" Margin="4,4,0,10"/>
                <Border Style="{StaticResource GlassCard}" Padding="8" MinHeight="90">
                    <ListBox Name="ListScreen" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MediaRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#2C3E50" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="打开" Tag="{Binding Path}" Width="64" Height="28" Margin="8,0,0,0"
                                                Style="{StaticResource GlassToolbarButton}" Click="OpenItem_Click"/>
                                        <Button Grid.Column="2" Content="文件夹" Tag="{Binding Path}" Width="64" Height="28" Margin="8,0,0,0"
                                                Style="{StaticResource GlassToolbarButton}" Background="#95A5A6" Click="OpenFolder_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
