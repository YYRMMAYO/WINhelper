<!-- 导航模块 key="recorder"：对应 WindowRecorder.xaml.cs，由 MainWindow._factories 注册。详见 MODULES.md -->
<UserControl x:Class="WINHELP.WindowRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WINHELP"
             Background="Transparent">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A90D9" Offset="0"/>
            <GradientStop Color="#356BB0" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="RecCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>
            <!-- ===== 顶部英雄横幅 ===== -->
            <Border Padding="22,18" Margin="0,0,0,16" CornerRadius="16" Background="{StaticResource HeroBrush}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="50" Height="50" CornerRadius="16" Background="#26FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="🎙️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Loc 录音录像|Audio &amp; Screen Recording}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{loc:Loc 检测电脑中已安装的录屏 / 录音软件并一键打开；未安装则前往官网下载|Detect installed screen/audio recorders and launch them, or download from official sites}" FontSize="12.5" Foreground="#DCEBFA" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 说明横幅：本软件不自带录音录像功能 ===== -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,18" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#FFF3E0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{loc:Loc 提示：本软件不自带录音录像功能。我们已自动扫描电脑中的录屏 / 录音软件；若未安装，请前往下方官网下载后再使用。|Note: this tool does not include built-in recording. We scanned your PC for recorders; if none found, download one from the official sites below.}" 
                               FontSize="13" Foreground="#8A5A00" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== 已安装的软件 ===== -->
            <TextBlock Text="{loc:Loc 🔎 已安装的录屏 / 录音软件|🔎 Installed Recorders}" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="TxtNone" Text="{loc:Loc 未检测到已安装的录屏 / 录音软件，可前往下方官网下载。|No installed recorder detected. Visit the official sites below to download.}" 
                       FontSize="13" Foreground="#95A5A6" Margin="4,0,0,12" TextWrapping="Wrap"/>
            <WrapPanel x:Name="FoundPanel" Orientation="Horizontal" Margin="0,0,0,18"/>

            <!-- ===== 前往官网下载 ===== -->
            <TextBlock Text="{loc:Loc 🌐 前往官网下载（推荐）|🌐 Download from Official Sites (Recommended)}" Style="{StaticResource SectionTitle}"/>
            <WrapPanel x:Name="RecommendPanel" Orientation="Horizontal"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
